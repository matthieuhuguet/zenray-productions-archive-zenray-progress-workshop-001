</style>
<div class="zrm-actions">
  <span class="zrm-action"><svg class="zrm-g"><use href="#g-cross"/></svg>{{intent}}</span>
  <span class="zrm-action"><svg class="zrm-g"><use href="#g-circle"/></svg>Retour</span>
  <span class="zrm-action"><svg class="zrm-g"><use href="#g-triangle"/></svg>Détails</span>
  <span class="zrm-action"><svg class="zrm-g" style="width:1.4em"><use href="#g-r1"/></svg>{{formatLabel}}</span>
