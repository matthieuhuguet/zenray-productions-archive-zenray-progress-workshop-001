x-width: 420px){.zrm-grid,.zrm-param{grid-template-columns:1fr}}.zrm-skeleton{pointer-events:none}.zrm-skeleton .zrm-thumb{background:var(--zrm-thumb-bg)}.zrm-sk-line{height:12px;border-radius:6px;background:var(--zrm-thumb-bg);margin-top:6px}.zrm-sk-short{width:55%}@media (prefers-reduced-motion: no-preference){.zrm-skeleton .zrm-thumb,.zrm-sk-line{animation:zrm-sk 1.4s ease-in-out infinite}@keyframes zrm-sk{0%,to{opacity:.55}50%{opacity:1}}}.zrm-count{margin-left:auto;color:var(--zrm-ink-2);font-size:13px;align-self:center}.zrm-more{display:flex;justify-content:center;padding:24px 0}.zrm-retry{margin-top:12px}.zrm-studio{display:block;width:100%;height:calc(100vh - 120px);min-height:560px;border:1px solid var(--zrm-line);border-radius:var(--zrm-radius);background:#fff}
