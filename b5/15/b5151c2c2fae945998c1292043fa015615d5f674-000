const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..')
try {
  const commit = execFileSync('gh', ['api', 'repos/matthieuhuguet/zenray-index-public/git/ref/heads/main', '--jq', '.object.sha'], { encoding: 'utf8', timeout: 30000 }).trim()
  const response = await fetch(`https://raw.githubusercontent.com/matthieuhuguet/zenray-index-public/${commit}/delta.json`, { signal: AbortSignal.timeout(45000) })
  if (!response.ok) throw new Error(`Delta HTTP ${response.status}`)
