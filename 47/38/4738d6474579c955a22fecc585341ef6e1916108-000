// POSER L'ICÔNE « SAUVEGARDÉ » SUR UN FICHIER, SANS EXTENSION NI SIGNATURE.
//
// POURQUOI CETTE VOIE. L'extension FinderSync est la manière propre de badger une icône, mais macOS refuse de
// l'enregistrer sans identité de développeur Apple, et c'est un mur qu'aucun code ne franchit. `NSWorkspace`
// offre une autre porte, ouverte depuis toujours : remplacer l'icône d'un fichier. Le Finder l'affiche
// immédiatement, partout, sans rien installer.
//
// CE QUE ÇA TOUCHE, ET CE QUE ÇA NE TOUCHE PAS. L'icône vit dans les métadonnées du fichier, jamais dans son
// contenu : l'empreinte sha256 ne bouge pas d'un bit, donc la sauvegarde ne voit aucun changement et ne renvoie
// rien. C'est la raison pour laquelle cette solution est acceptable sur des fichiers qu'on tient à préserver.
//
// Usage :  zrc-icone poser <fichier> [...]      pose le nuage
//          zrc-icone retirer <fichier> [...]    rend l'icône d'origine
//          zrc-icone apercu <modèle> <out.png>   écrit le rendu exact, pour le regarder avant de le poser
import AppKit

let BADGE_PART: CGFloat = 0.42          // le nuage occupe ce quart bas-droit de l'icône
let GRIS_NUAGE = NSColor(calibratedRed: 0.47, green: 0.47, blue: 0.44, alpha: 1)

// LE NUAGE EST CELUI D'APPLE, TRACÉ AU BÉZIER, PAS TROIS BULLES EMPILÉES.
//
// La première version dessinait deux ovales et un rectangle arrondi, ce qui donne bien un nuage de loin et
// une bouillie de près : les ovales se recoupent en créant des bosses que le lissage du Finder accentue à
// petite taille. Matthieu l'a dit sans détour le 2026-08-18, et il avait raison.
//
// Ce contour-ci vient du SVG qu'il a fourni, `cloud.fill` de SF Symbols, dans son repère d'origine de
// 37,793 × 28,0195 points. On le garde ÉCRIT TEL QUEL, coordonnée pour coordonnée, et c'est délibéré : le
// transposer à la main en nombres « propres » interdirait de le comparer à sa source, alors qu'ainsi une
// simple lecture côte à côte suffit à vérifier qu'aucun point n'a bougé.
let NUAGE_LARGEUR: CGFloat = 37.793
let NUAGE_HAUTEUR: CGFloat = 28.0195

/// Le contour du nuage, ajusté dans `cadre` sans jamais le déformer : le SVG est plus large que haut, donc
/// on l'inscrit à l'échelle du côté le plus contraignant, puis on le centre.
///
/// LE REPÈRE S'INVERSE, et l'oublier retourne le nuage à l'envers sans qu'aucune erreur ne le signale : un
/// SVG compte ses ordonnées vers le BAS, AppKit vers le HAUT. La conversion tient donc dans `P`, et elle est
/// le seul endroit du fichier où l'on touche aux coordonnées.
func cheminNuage(dans cadre: NSRect) -> NSBezierPath {
    let e = min(cadre.width / NUAGE_LARGEUR, cadre.height / NUAGE_HAUTEUR)
    let ox = cadre.minX + (cadre.width - NUAGE_LARGEUR * e) / 2
    let oy = cadre.minY + (cadre.height - NUAGE_HAUTEUR * e) / 2
    func P(_ x: CGFloat, _ y: CGFloat) -> NSPoint {
        NSPoint(x: ox + x * e, y: oy + (NUAGE_HAUTEUR - y) * e)
    }
    let c = NSBezierPath()
    c.move(to: P(29.4961, 25.7695))
    c.curve(to: P(37.4414, 18.4922), controlPoint1: P(33.9609, 25.7695), controlPoint2: P(37.4414, 22.5469))
    c.curve(to: P(32.707, 11.4961), controlPoint1: P(37.4414, 15.3867), controlPoint2: P(35.6836, 12.668))
    c.curve(to: P(21.9609, 0), controlPoint1: P(32.7891, 4.83984), controlPoint2: P(28.0312, 0))
    c.curve(to: P(13.2422, 4.91016), controlPoint1: P(17.8477, 0), controlPoint2: P(14.9766, 2.22656))
    c.curve(to: P(5.50781, 10.7344), controlPoint1: P(9.58594, 3.72656), controlPoint2: P(5.55469, 6.53906))
    c.curve(to: P(0, 17.7891), controlPoint1: P(2.14453, 11.2031), controlPoint2: P(0, 14.1445))
    c.curve(to: P(8.84766, 25.7578), controlPoint1: P(0, 22.1602), controlPoint2: P(3.79688, 25.7578))
    c.close()
    return c
}

/// La pastille blanche derrière le nuage n'est pas une décoration : sans elle, un nuage gris posé sur une
/// vignette de photo sombre disparaît purement et simplement. Dropbox et Drive font exactement pareil.
func nuage(taille: CGFloat) -> NSImage {
    let img = NSImage(size: NSSize(width: taille, height: taille))
    img.lockFocus()
    let pastille = NSBezierPath(roundedRect: NSRect(x: 0, y: 0, width: taille, height: taille),
                                xRadius: taille * 0.28, yRadius: taille * 0.28)
    NSColor.white.setFill(); pastille.fill()
    NSColor(calibratedWhite: 0, alpha: 0.12).setStroke(); pastille.lineWidth = taille * 0.04; pastille.stroke()

    GRIS_NUAGE.setFill()
    // Une marge de 22 % laisse le nuage respirer dans sa pastille : collé aux bords, il se lit comme une tache.
    let m = taille * 0.22
    cheminNuage(dans: NSRect(x: m, y: m, width: taille - 2 * m, height: taille - 2 * m)).fill()
    img.unlockFocus()
    return img
}

func poser(_ chemin: String) -> Bool {
    let ws = NSWorkspace.shared
    let base = ws.icon(forFile: chemin)
    let cote = max(base.size.width, 128)
    let composee = NSImage(size: NSSize(width: cote, height: cote))
    composee.lockFocus()
    base.draw(in: NSRect(x: 0, y: 0, width: cote, height: cote))
    let t = cote * BADGE_PART
    // En bas à droite, comme Dropbox et Drive : c'est là que l'œil va chercher un état, et nulle part ailleurs.
    nuage(taille: t).draw(in: NSRect(x: cote - t - cote * 0.02, y: cote * 0.02, width: t, height: t))
    composee.unlockFocus()
    return ws.setIcon(composee, forFile: chemin, options: [])
}

func retirer(_ chemin: String) -> Bool {
    NSWorkspace.shared.setIcon(nil, forFile: chemin, options: [])
}

/// APERÇU — écrit dans un PNG ce que le Finder affichera, badge compris, pour le vérifier de ses yeux
/// avant de le poser sur des milliers de fichiers. Une icône ne se contrôle pas autrement qu'en la regardant.
func apercu(_ modele: String, _ sortie: String) -> Bool {
    let base = NSWorkspace.shared.icon(forFile: modele)
    let cote: CGFloat = 512
    let composee = NSImage(size: NSSize(width: cote, height: cote))
    composee.lockFocus()
    base.draw(in: NSRect(x: 0, y: 0, width: cote, height: cote))
    let t = cote * BADGE_PART
    nuage(taille: t).draw(in: NSRect(x: cote - t - cote * 0.02, y: cote * 0.02, width: t, height: t))
    composee.unlockFocus()
    guard let tiff = composee.tiffRepresentation, let rep = NSBitmapImageRep(data: tiff),
          let png = rep.representation(using: .png, properties: [:]) else { return false }
    return (try? png.write(to: URL(fileURLWithPath: sortie))) != nil
}

let args = CommandLine.arguments
if args.count == 4 && args[1] == "apercu" {
    exit(apercu(args[2], args[3]) ? 0 : 1)
}
guard args.count >= 3, args[1] == "poser" || args[1] == "retirer" else {
    FileHandle.standardError.write("usage: zrc-icone poser|retirer <fichier> [...] | apercu <modèle> <sortie.png>\n".data(using: .utf8)!)
    exit(2)
}
var faits = 0, rates = 0
for chemin in args.dropFirst(2) {
    let ok = args[1] == "poser" ? poser(chemin) : retirer(chemin)
    if ok { faits += 1 } else { rates += 1 }
}
print("\(faits) icône(s) posée(s), \(rates) échec(s)")
exit(rates > 0 && faits == 0 ? 1 : 0)
