@font-face{font-family:AnthropicSerifMedium;src:url(/fonts/AnthropicSerif-Medium.ttf) format("truetype");font-weight:500;font-display:swap}.zrb-root{--zrb-sans: "InterVariable", "Inter", "Hiragino Sans W4", "Hiragino Sans", sans-serif;--zrb-serif: "AnthropicSerifMedium", "AnthropicSerif", "Hiragino Mincho ProN W3", serif;--zrb-mono: "AnthropicMono", ui-monospace, monospace;--zrb-bg-page: #FAF8F4;--zrb-bg-sub: #F2EFE9;--zrb-fg-ink: #181715;--zrb-fg-muted: #78746C;--zrb-line-hair: rgba(24, 23, 21, .09);--zrb-book-size: 18px;--zrb-book-lh: 1.72;--zrb-book-width: 54ch;--zrb-page-pad: 40px;background:var(--zrb-bg-page);color:var(--zrb-fg-ink);font-family:var(--zrb-sans);font-weight:500;border-radius:14px;border:1px solid var(--zrb-line-hair);min-height:calc(100vh - 110px);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;box-shadow:0 12px 34px #00000014;-webkit-font-smoothing:antialiased}.zrb-root[data-theme=sepia]{--zrb-bg-page: #F3EBD9;--zrb-bg-sub: #E8DEC8;--zrb-fg-ink: #262018;--zrb-fg-muted: #786B58;--zrb-line-hair: rgba(38, 32, 24, .11)}.zrb-root[data-theme=nuit]{--zrb-bg-page: #16171A;--zrb-bg-sub: #1E2024;--zrb-fg-ink: #EAE8E3;--zrb-fg-muted: #8C8A84;--zrb-line-hair: rgba(255, 255, 255, .09)}.zrb-num{font-family:var(--zrb-serif);font-weight:500;font-variant-numeric:tabular-nums}.zrb-top{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px 32px;border-bottom:1px solid var(--zrb-line-hair);font-size:12.5px;color:var(--zrb-fg-muted)}.zrb-brand{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}.zrb-brand-title{font-family:var(--zrb-serif);font-weight:500;font-size:18px;color:var(--zrb-fg-ink)}.zrb-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.zrb-tab-btn{background:none;border:none;border-bottom:1.5px solid transparent;padding:2px 0;font-family:var(--zrb-sans);font-weight:500;font-size:12.5px;color:var(--zrb-fg-muted);cursor:pointer}.zrb-tab-btn.is-active{color:var(--zrb-fg-ink);border-bottom-color:var(--zrb-fg-ink)}.zrb-pill-btn{background:var(--zrb-bg-sub);border:1px solid var(--zrb-line-hair);color:var(--zrb-fg-ink);font-family:var(--zrb-sans);font-weight:500;font-size:12px;padding:5px 11px;border-radius:8px;cursor:pointer}.zrb-pill-btn.is-primary{background:var(--zrb-fg-ink);color:var(--zrb-bg-page)}.zrb-search-input{background:var(--zrb-bg-sub);border:1px solid var(--zrb-line-hair);color:var(--zrb-fg-ink);font-family:var(--zrb-sans);font-weight:500;font-size:12px;padding:5px 10px;border-radius:8px;width:190px;outline:none}.zrb-aa-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:12px 32px;background:var(--zrb-bg-sub);border-bottom:1px solid var(--zrb-line-hair);font-size:12px}.zrb-aa-group{display:flex;align-items:center;gap:8px}.zrb-aa-group input[type=range]{width:84px;accent-color:var(--zrb-fg-ink);cursor:pointer}.zrb-shelf-wrap{flex:1;padding:16px 32px 24px;overflow-x:auto}.zrb-editorial-table{width:100%;border-collapse:collapse;font-size:12.5px}.zrb-editorial-table th{text-align:left;font-weight:500;font-size:11px;color:var(--zrb-fg-muted);padding:9px 10px;border-bottom:1px solid var(--zrb-line-hair);white-space:nowrap}.zrb-editorial-table td{padding:10px;border-bottom:1px solid var(--zrb-line-hair);color:var(--zrb-fg-ink);vertical-align:middle}.zrb-editorial-table tbody tr{cursor:pointer;transition:background .12s ease}.zrb-editorial-table tbody tr:hover{background:var(--zrb-bg-sub)}.zrb-book-cell{display:flex;align-items:center;gap:12px}.zrb-tiny-cover{width:26px;height:38px;border-radius:3px;flex-shrink:0;object-fit:cover;display:flex;align-items:center;justify-content:center;font-family:var(--zrb-serif);font-size:9px;color:#faf8f4;border:1px solid var(--zrb-line-hair)}.zrb-row-title{font-family:var(--zrb-serif);font-weight:500;font-size:14.5px;color:var(--zrb-fg-ink)}.zrb-cloud-pill{display:inline-block;padding:2px 8px;border-radius:99px;background:var(--zrb-bg-sub);border:1px solid var(--zrb-line-hair);color:var(--zrb-fg-ink);font-size:11px;white-space:nowrap}.zrb-cloud-pill.is-cloud{background:var(--zrb-fg-ink);color:var(--zrb-bg-page)}.zrb-prog-cell{display:flex;flex-direction:column;gap:4px;min-width:130px}.zrb-mini-bar{height:2px;background:var(--zrb-line-hair);border-radius:99px;overflow:hidden}.zrb-mini-bar>div{height:100%;background:var(--zrb-fg-ink)}.zrb-spread-container{flex:1;display:flex;flex-direction:column;justify-content:center}.zrb-two-page-spread{flex:1;display:grid;grid-template-columns:1fr 1px 1fr;gap:48px;padding:var(--zrb-page-pad) 48px;align-items:start}@media (max-width: 960px){.zrb-two-page-spread{grid-template-columns:1fr;gap:28px;padding:24px 22px}.zrb-spine-line{display:none}}.zrb-spine-line{width:1px;height:100%;min-height:420px;background:var(--zrb-line-hair)}.zrb-prose-col{width:100%;max-width:var(--zrb-book-width);margin:0 auto;font-family:var(--zrb-serif);font-weight:500;font-size:var(--zrb-book-size);line-height:var(--zrb-book-lh);color:var(--zrb-fg-ink)}.zrb-ch-label{font-family:var(--zrb-sans);font-weight:500;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--zrb-fg-muted);margin-bottom:10px}.zrb-ch-title{font-family:var(--zrb-serif);font-weight:500;font-size:calc(var(--zrb-book-size) * 1.38);line-height:1.25;margin-bottom:18px}.zrb-prose-col p{margin-bottom:14px;white-space:pre-line}.zrb-warm-hl{background:#f2c24447;padding:1px 3px;border-radius:3px}.zrb-bottom{padding:13px 32px 16px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid var(--zrb-line-hair);font-size:12px;color:var(--zrb-fg-muted)}.zrb-hair-progress{flex:1;max-width:280px;height:2px;background:var(--zrb-line-hair);border-radius:99px;overflow:hidden}.zrb-hair-fill{height:100%;background:var(--zrb-fg-ink)}
