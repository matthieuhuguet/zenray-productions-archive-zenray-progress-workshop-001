/* ── LES POLICES DE ZenRayCloud, ALIGNÉES SUR LA RÈGLE GLOBALE (2026-08-18) ────────────────────────
   Le trio est fixé dans `~/.claude/CLAUDE.md` : Inter pour le sans, AnthropicSerif pour le serif,
   `ui-monospace` pour le mono. L'app affichait encore Hiragino Sans W4, y compris là où elle voulait du
   mono — « 'Hiragino Sans W4', ui-monospace » demande donc une proportionnelle AVANT la chasse fixe, ce
   qui annule l'intention. Les deux fichiers sont SERVIS par l'app et non attendus du système : une
   police système est un pari sur la machine, et ce pari se perd en silence.

   Inter ne dessine aucun kana : Hiragino Sans W4 reste derrière elle pour les caractères japonais, et le
   repli se fait glyphe par glyphe. */
@font-face {
  font-family: 'Inter';
  src: url('./fonts/InterVariable.woff2') format('woff2-variations');
  font-weight: 100 900; font-style: normal; font-display: swap;
}
@font-face {
  font-family: 'AnthropicMono';
  src: url('./fonts/AnthropicMono.woff2') format('woff2');
  font-weight: 100 900; font-style: normal; font-display: swap;
}
:root {
  --zrc-sans: 'Inter', 'Hiragino Sans W4', -apple-system, system-ui, sans-serif;
  --zrc-mono: ui-monospace, SFMono-Regular, Menlo, 'AnthropicMono', 'Hiragino Sans W4', monospace;
}

/* DIRECTION ARTISTIQUE — la même que le reste de ZenRay : fond clair, gris, un seul accent corail, polices
   Anthropic installées sur la machine (donc disponibles sans embarquer de fichier), graisses jusqu'au Medium. */
/* CES VALEURS SONT UN REPLI, PAS LA SOURCE. La source est `params.json`, envoyée par le processus principal au
   premier rendu et posée sur :root. Elles ne servent donc qu'aux quelques millisecondes qui précèdent, et à
   garder le fichier lisible seul. Modifier une couleur ICI ne suffit pas : c'est params.json qui gouverne. */
:root {
  --fond: #f7f7f5;
  --carte: #ffffff;
  --trait: #e7e6e2;
  --texte: #1b1b19;
  --gris: #8a8a85;
  --accent: #cc7c5e;
  --bleu: #2f6fed;
  --vert: #22c98a;
  --rouge: #9b5a57;
  --orange: #e6a03c;
  /* Hiragino Sans W4 partout dans l'app, comme sur le site. Nom de famille COMPLET : sur macOS « W4 » est une
     famille à part entière, la demander autrement laisse le système choisir une graisse voisine. */
  font-family: var(--zrc-sans);
}

* { box-sizing: border-box; }
html, body, #root { height: 100%; margin: 0; }
body { background: var(--fond); color: var(--texte); font-size: 14px; -webkit-font-smoothing: antialiased; }

.barre-titre { height: 38px; -webkit-app-region: drag; }
button, input, select { font-family: inherit; -webkit-app-region: no-drag; }

.page { max-width: 880px; margin: 0 auto; padding: 0 24px 40px; }

.entete { display: flex; align-items: baseline; gap: 12px; padding: 4px 0 18px; }
.entete h1 { font-size: 22px; font-weight: 500; margin: 0; letter-spacing: -0.01em; }
.entete .compte { color: var(--gris); font-size: 13px; }
.entete .actions { margin-left: auto; display: flex; gap: 8px; }

.btn {
  border: 1px solid var(--trait); background: var(--carte); color: var(--texte);
  border-radius: 99px; padding: 7px 14px; font-size: 13px; cursor: pointer; transition: background .12s;
}
.btn:hover { background: #f2f1ee; }
.btn:disabled { opacity: .45; cursor: default; }
.btn.primaire { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn.primaire:hover { background: #bb6f53; }
.btn.discret { border-color: transparent; background: transparent; color: var(--gris); padding: 6px 8px; }
.btn.discret:hover { background: #efeeeb; color: var(--texte); }

.bandeau { display: flex; gap: 10px; align-items: center; background: #fff5f0; border: 1px solid #f0d5c8;
  border-radius: 12px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; }
.bandeau .titre { font-weight: 500; }

.carte { background: var(--carte); border: 1px solid var(--trait); border-radius: 14px; padding: 14px 16px; margin-bottom: 10px; }
.ligne { display: flex; align-items: center; gap: 12px; }
.nom { font-size: 15px; font-weight: 500; letter-spacing: -0.01em; }
.chemin { color: var(--gris); font-size: 12px; font-family: var(--zrc-mono);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* L'état et les boutons ne se laissent jamais pousser à la ligne par un chemin long : c'est le chemin qui
   se tronque, parce qu'il est le seul dont on peut perdre la fin sans perdre l'information. */
.etat { white-space: nowrap; }
.ligne > .btn { flex: 0 0 auto; }

.pastille { width: 8px; height: 8px; border-radius: 99px; flex: 0 0 auto; }
.etat { display: inline-flex; align-items: center; gap: 6px; color: var(--gris); font-size: 12px; }

.champ { border: 1px solid var(--trait); background: #fbfbfa; border-radius: 8px; padding: 6px 10px;
  font-size: 12px; font-family: var(--zrc-mono); color: var(--texte); width: 100%; outline: none; }
.champ:focus { border-color: var(--accent); }

.jauge { height: 4px; background: #eeedea; border-radius: 99px; overflow: hidden; margin-top: 10px; }
.jauge > div { height: 100%; background: var(--bleu); transition: width .2s; }
.jauge.fine { height: 3px; margin-top: 4px; }
.jauge.fine > div { background: var(--accent); }

.resume { color: var(--gris); font-size: 12px; margin-top: 8px; }
.resume b { font-weight: 500; color: var(--texte); }

.journal { margin-top: 10px; background: #1b1b19; color: #d9d8d3; border-radius: 10px; padding: 10px 12px;
  font-family: var(--zrc-mono); font-size: 11px; line-height: 1.55;
  max-height: 220px; overflow: auto; white-space: pre-wrap; }

.prefs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
.prefs label { display: block; color: var(--gris); font-size: 12px; margin-bottom: 4px; }
.section-titre { font-size: 12px; font-weight: 500; color: var(--gris); text-transform: uppercase;
  letter-spacing: .06em; margin: 22px 0 10px; }

.vide { text-align: center; color: var(--gris); padding: 48px 0; font-size: 13px; }

/* ── LE PANNEAU VIVANT ────────────────────────────────────────────────────── */
.vivant { display: flex; align-items: center; gap: 16px; margin-top: 12px; padding: 12px 14px;
  background: #fbfbfa; border: 1px solid var(--trait); border-radius: 12px; }
.vitesse { display: flex; align-items: baseline; gap: 5px; min-width: 108px; }
.vitesse b { font-size: 30px; font-weight: 500; letter-spacing: -0.02em; color: var(--bleu);
  font-variant-numeric: tabular-nums; }
.vitesse span { font-size: 12px; color: var(--gris); }
.vivant-detail { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; }
.vivant-phase { font-size: 13px; font-weight: 500; color: var(--texte); }
.vivant-detail .chemin { font-size: 11px; }

/* ── LE TABLEAU DES FICHIERS ──────────────────────────────────────────────── */
.tableau { margin-top: 10px; border: 1px solid var(--trait); border-radius: 12px; overflow: hidden; }
.tableau-tete { display: flex; align-items: center; justify-content: space-between; padding: 6px 10px;
  background: #fbfbfa; border-bottom: 1px solid var(--trait); color: var(--gris); font-size: 12px; }
.tableau table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.tableau td { padding: 5px 10px; border-bottom: 1px solid #f2f1ee; vertical-align: middle; }
.tableau tr:last-child td { border-bottom: 0; }
.col-etat { width: 54px; white-space: nowrap; }
.col-etat svg { margin-right: 5px; vertical-align: middle; }
.col-nom { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.col-taille { width: 78px; text-align: right; color: var(--gris); font-variant-numeric: tabular-nums; }
.col-date { width: 128px; color: var(--gris); white-space: nowrap; }
.col-chemin { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.depuis, .versions { margin-left: 7px; padding: 1px 6px; border-radius: 99px; font-size: 10.5px;
  background: #f0efec; color: var(--gris); }

/* ── LES MORCEAUX EN ATTENTE ──────────────────────────────────────────────── */
.morceaux { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
.morceau { font-family: var(--zrc-mono); font-size: 10.5px; color: var(--gris);
  background: #f2f1ee; border-radius: 6px; padding: 2px 7px; white-space: nowrap; }
.morceau b { color: var(--texte); font-weight: 500; }
.morceaux.vide { color: var(--vert); font-size: 11.5px; }
.lien { border: 0; background: none; padding: 0; color: var(--accent); cursor: pointer; font: inherit;
  text-decoration: underline; }

/* ── LOT B : ce que l'application dit d'elle-même (2026-08-16) ─────────────────────────────────────
   Toutes ces classes servent une seule idée : un envoi qui dure des heures doit rester lisible sans
   qu'on ouvre le journal. Aucune n'ajoute de fonction, elles rendent visible ce qui existait déjà. */
.reste { color: var(--gris); font-weight: 400; }
.compteurs { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; color: var(--gris); font-size: 12px; }
.compteurs b { color: var(--texte); font-weight: 500; }
.sautes { margin-top: 6px; color: var(--rouge); font-size: 12px; }
.bilan { margin-top: 10px; padding: 8px 11px; border-radius: 9px; background: #f2f1ee; font-size: 12.5px;
  color: var(--texte); }
.bilan.ko { background: #fdf2f0; }
.ko-texte { color: var(--rouge); }
.onglets { display: flex; gap: 6px; margin-top: 10px; }
.onglets .actif { background: var(--accent); color: #fff; border-color: transparent; }
.semantique { width: 100%; border-collapse: collapse; font-size: 12.5px; }
.semantique td { padding: 5px 10px 5px 0; border-top: 1px solid #ececea; vertical-align: top; }
.semantique tr:first-child td { border-top: 0; }
.col-action { text-align: right; white-space: nowrap; padding-left: 10px; }
.drive-etat { margin-top: 8px; padding: 7px 10px; border-radius: 8px; background: #eef4fb; }
.voies-ok { color: var(--gris); font-weight: 400; }
.voies-ko { color: var(--rouge); font-weight: 500; }

/* ── LES NOMBRES EN SERIF (2026-08-18, demande de Matthieu) ────────────────────────────────────────
   Seuls les CHIFFRES changent de famille, jamais les libellés qui les accompagnent : un nombre en serif
   à côté de son unité en sans se lit comme une donnée posée sur une étiquette, et c'est exactement la
   hiérarchie qu'on veut. `tabular-nums` va avec, sans quoi un compteur qui défile ferait danser la ligne
   à chaque changement de chiffre. */
@font-face {
  font-family: 'AnthropicSerif';
  src: url('./fonts/AnthropicSerif-Romans.woff2') format('woff2');
  font-weight: 100 900; font-style: normal; font-display: swap;
}
.n, .vitesse b, .compteurs b, .bilan b, .tableau-tete span, .col-taille, .morceau b {
  font-family: 'AnthropicSerif', Georgia, serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}
.vitesse b { font-weight: 500; }

/* ── LA FRISE ET LE RUBAN (2026-08-18, adoucis le soir même) ───────────────────────────────────────
   La première version employait le bleu d'action, celui des boutons : un aplat saturé sur des éléments
   purement informatifs. Un repère n'a pas à crier plus fort que la donnée qu'il repère, et le contraste
   maximal doit rester réservé à ce qui se clique. Trois tons suffisent donc, tous désaturés : un gris
   pour ce qui est franchi, un bleu très pâle pour l'endroit où l'on se trouve, un contour à peine visible
   pour ce qui reste à faire. La lecture se fait par la DENSITÉ et non par la couleur. */
:root {
  --etape-faite: #c4c3bf;
  --etape-ici: #93b4e8;
  --etape-halo: rgba(147, 180, 232, .22);
  --etape-avenir: #e3e2de;
  --capsule-ici: #eaf0fa;
  
}
.frise { display: flex; align-items: flex-start; gap: 0; margin-top: 12px; }
.frise-pas { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; position: relative; }
/* Le trait de liaison naît du pas précédent : une frise sans lien se lit comme six objets séparés. */
.frise-pas::before { content: ''; position: absolute; top: 3.5px; right: 50%; left: -50%; height: 1px;
  background: var(--etape-avenir); }
.frise-pas:first-child::before { display: none; }
.frise-pas.fait::before { background: var(--etape-faite); }
.frise-pas.ici::before { background: var(--etape-ici); }
.frise-point { width: 8px; height: 8px; border-radius: 99px; box-sizing: border-box; position: relative; z-index: 1;
  background: #fff; border: 1.5px solid var(--etape-avenir);
  transition: background .3s ease, border-color .3s ease, box-shadow .3s ease; }
.frise-pas.fait .frise-point { background: var(--etape-faite); border-color: var(--etape-faite); }
/* L'étape courante est la seule à porter un halo, et il est volontairement diffus : on doit la trouver
   sans la chercher, pas la subir. */
.frise-pas.ici .frise-point { background: var(--etape-ici); border-color: var(--etape-ici);
  box-shadow: 0 0 0 5px var(--etape-halo); }
.frise-nom { font-size: 10.5px; color: var(--gris); letter-spacing: .01em; }
.frise-pas.ici .frise-nom { color: var(--texte); font-weight: 500; }
.frise-pas.avenir .frise-nom { opacity: .5; }

.ruban { display: flex; gap: 6px; margin-top: 10px; overflow: hidden; }
.ruban-item { flex: 0 1 auto; min-width: 0; max-width: 190px; overflow: hidden; text-overflow: ellipsis;
  white-space: nowrap; border-radius: 99px; padding: 3.5px 11px; font-size: 11.5px; }
/* Le fichier en cours se distingue par un fond à peine teinté et un texte plein, jamais par un aplat
   inversé : le blanc sur bleu attire l'œil plus qu'un bouton, ce qui est exactement l'inverse du besoin. */
.ruban-item.encours { background: var(--capsule-ici); color: var(--texte); font-weight: 500; }
.ruban-item.fini { background: #f4f3f0; color: var(--gris); }
.ruban-item.fini:nth-child(3) { opacity: .8 }
.ruban-item.fini:nth-child(4) { opacity: .64 }
.ruban-item.fini:nth-child(5) { opacity: .5 }
.ruban-item.fini:nth-child(n+6) { opacity: .38 }

/* ── LA PROGRESSION GLOBALE ET LA RESPIRATION (2026-08-18) ─────────────────────────────────────────
   Deux réponses à « on dirait que c'est bloqué », et aucune n'est décorative. La barre globale répond en
   donnant l'échelle qui manquait : celle du dossier entier, quand la barre du dessus ne mesure que le
   passage. La respiration répond en montrant que l'application est vivante — mais elle ne s'applique
   qu'au SEUL point de l'étape courante, et son amplitude reste sous le seuil où l'œil s'en fatigue. */
.global { margin-top: 12px; }
.global-jauge { height: 3px; border-radius: 99px; background: var(--etape-avenir); overflow: hidden; }
/* Un dégradé fixe, pas un balayage : une lueur qui traverse la barre serait vue comme du chargement,
   alors que cette barre-ci mesure un acquis. */
.global-jauge > div { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #b9cdec, #93b4e8);
  transition: width .6s cubic-bezier(.16,1,.3,1); }
.global-texte { margin-top: 5px; font-size: 11.5px; color: var(--gris); }
.global-texte b { color: var(--texte); font-weight: 500; }

.chrono { color: var(--gris); font-weight: 400; }
.chrono::before { content: ' · '; }

/* LA RESPIRATION. Trois secondes par cycle, et une amplitude d'opacité de 0,22 à 0,10 sur le seul halo :
   assez pour qu'un regard posé la remarque, trop peu pour qu'un regard de travail la subisse. Le point
   lui-même ne bouge NI en taille NI en couleur, sans quoi la frise deviendrait un objet clignotant. */
@keyframes zrc-respire {
  0%, 100% { box-shadow: 0 0 0 5px rgba(147, 180, 232, .22); }
  50%      { box-shadow: 0 0 0 7px rgba(147, 180, 232, .10); }
}
.frise-pas.ici .frise-point { animation: zrc-respire 3s ease-in-out infinite; }
/* Une préférence système d'accessibilité vaut plus que n'importe quelle intention de design. */
@media (prefers-reduced-motion: reduce) { .frise-pas.ici .frise-point { animation: none; } }

/* La capsule du fichier en cours reçoit la même respiration, en plus discrète encore : c'est le second
   endroit où l'œil se pose quand il cherche à savoir si quelque chose avance. */
@keyframes zrc-capsule { 0%, 100% { background: #eaf0fa } 50% { background: #f1f5fc } }
.ruban-item.encours { animation: zrc-capsule 3s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) { .ruban-item.encours { animation: none; } }

/* ── LA HIÉRARCHIE DU PANNEAU (2026-08-18) ─────────────────────────────────────────────────────────
   Trois niveaux, trois poids visuels, et un ordre de lecture qui ne se discute pas : où en est-on, que
   fait-il, puis le détail pour qui le cherche. L'écran précédent avait tout au même poids, ce qui revient
   à n'avoir aucune hiérarchie : deux barres se chevauchaient et les chiffres s'empilaient sur trois rangs.
   Rien n'a été retiré, tout a été rangé. */

/* NIVEAU 1 — l'anneau porte la seule grandeur qui répond à « où en est-on ». La forme ronde n'est pas un
   ornement : une jauge linéaire de plus se serait confondue avec les deux autres barres. */
.tete { display: flex; align-items: center; gap: 16px; margin-top: 14px; }
.anneau { position: relative; width: 64px; height: 64px; flex: 0 0 64px; }
.anneau svg { display: block; }
.anneau-fond { fill: none; stroke: var(--etape-avenir); stroke-width: 5; }
.anneau-arc { fill: none; stroke: var(--etape-ici); stroke-width: 5; stroke-linecap: round;
  transition: stroke-dasharray .8s cubic-bezier(.16,1,.3,1); }
.anneau-valeur { font-family: 'AnthropicSerif', Georgia, serif; font-size: 16px; font-weight: 500;
  fill: var(--texte); font-variant-numeric: tabular-nums; }
.anneau-unite { font-size: 9px; fill: var(--gris); font-family: var(--zrc-sans); }
.tete-texte { min-width: 0; flex: 1; }
.tete-titre { font-size: 26px; line-height: 1.1; color: var(--texte); }
.tete-titre b { font-weight: 500; }
.tete-unite { font-size: 12.5px; color: var(--gris); }
.tete-sous { margin-top: 3px; font-size: 12px; color: var(--gris); }
.tete-etat { display: flex; flex-direction: column; align-items: flex-end; gap: 2px;
  font-size: 11.5px; color: var(--gris); flex: 0 0 auto; }
.tete-etat .chrono::before { content: none; }

/* NIVEAU 2 — l'acte en cours, en une ligne, juste au-dessus de la frise qui le situe. */
.acte { display: flex; align-items: baseline; gap: 8px; margin-top: 14px; }
.acte-verbe { font-size: 13.5px; color: var(--texte); font-weight: 500; }
.acte-reste { font-size: 11.5px; color: var(--gris); }

/* NIVEAU 3 — le détail technique. Même information qu'avant, un cran plus bas : ce n'est pas ce qu'on
   regarde, c'est ce qu'on consulte, et son poids visuel doit le dire. */
.detail { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--etape-avenir); }
.detail-ligne { font-size: 11px; line-height: 1.65; }

/* ── LA CARTE, REBÂTIE SUR LA MAQUETTE (2026-08-18) ────────────────────────────────────────────────
   Quatre tuiles, une frise chiffrée, un pied technique. La règle qui a guidé le rangement : AUCUNE
   information ne disparaît, chacune change seulement de rang. Ce qui se lit d'un coup d'œil monte dans
   les tuiles, ce qui se consulte descend dans le pied, ce qui se fait rarement entre dans le menu. */
.tete-carte { display: flex; align-items: flex-start; gap: 14px; }
.tete-id { display: flex; align-items: flex-start; gap: 10px; min-width: 0; flex: 1; }
.tete-nom { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 500; color: var(--texte); }
.tete-route { display: flex; align-items: center; gap: 7px; margin-top: 2px; font-size: 11.5px; }
.tete-route > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px; }
.fleche { color: var(--gris); }
.tete-actions { display: flex; gap: 7px; flex: 0 0 auto; }
.badge { font-size: 10.5px; font-weight: 500; padding: 2px 8px; border-radius: 99px;
  background: var(--capsule-ici); color: #3f5f96; }
.badge-error { background: #fdecea; color: #a3382c }
.badge-paused { background: #f1f0ec; color: var(--gris) }

.volet { margin-top: 12px; padding: 12px 14px; border-radius: 12px; background: var(--fond); }
.volet label { display: block; font-size: 11.5px; color: var(--gris); margin-bottom: 5px; }
.volet-case { display: flex; align-items: center; gap: 8px; margin-top: 9px; margin-bottom: 0; }
.volet-menu { display: flex; flex-wrap: wrap; gap: 7px; }
.btn.danger { color: var(--rouge); }

/* Les tuiles : quatre colonnes qui se replient sur les fenêtres étroites, sans jamais superposer. */
.tuiles { display: grid; grid-template-columns: 1.35fr 1.15fr .7fr .8fr; gap: 12px; margin-top: 14px; }
@media (max-width: 820px) { .tuiles { grid-template-columns: 1fr 1fr } }
.tuile { padding: 13px 15px; border-radius: 14px; background: var(--fond); border: 1px solid var(--etape-avenir); }
.tuile-titre { font-size: 10.5px; color: var(--gris); letter-spacing: .02em; }
.tuile-corps { display: flex; align-items: center; gap: 14px; margin-top: 8px; }
.tuile-fait { margin-top: 6px; font-size: 12.5px; color: var(--texte); }
.grand { font-size: 25px; line-height: 1.15; color: var(--texte); margin-top: 4px; }
.grand b { font-weight: 500 }
.grand-unite { font-size: 12.5px; color: var(--gris) }
.petit { font-size: 11.5px; color: var(--gris); margin-top: 3px; }
.statut-ligne { display: flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 13.5px; }
.coche { width: 18px; height: 18px; border-radius: 99px; display: grid; place-items: center;
  font-size: 11px; color: #fff; background: var(--vert); flex: 0 0 18px; }
.coche.encours { background: var(--etape-ici) }
.coche.ko { background: var(--rouge) }
.filtres { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.jeton { font-size: 11px; padding: 2px 9px; border-radius: 99px; background: var(--capsule-ici); color: #3f5f96; }

.frise-chiffre { font-size: 10px; color: var(--gris); opacity: .85; }
.pied { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; margin-top: 14px;
  padding-top: 11px; border-top: 1px solid var(--etape-avenir); font-size: 11px; }
.pied-lien { margin-left: auto; }

.pied-item { color: var(--gris) }
.pied-item b.chemin, .pied-item b { font-weight: 500; color: var(--texte) }
