<script>
// 21 October 2026, 00:35 CEST: A single content model renders every direction and navigation level.
const DATA=JSON.parse(document.getElementById('fixture').textContent);
const VARIANTS={A:{name:'Galerie',description:'Fond ivoire, images alignées et légendes sous les œuvres. Une bibliothèque calme, lisible sans survol.',gap:32,inset:52,columns:3,radius:5,title:21},B:{name:'Immersion',description:'Fond graphite et grandes images seules. Les titres et les sources apparaissent au survol ou au clavier.',gap:34,inset:64,columns:3,radius:5,title:23},C:{name:'Répertoire',description:'Fond minéral, grille carrée et navigation compacte. Plus de références à l’écran, sans superpositions.',gap:28,inset:44,columns:4,radius:2,title:19}};
