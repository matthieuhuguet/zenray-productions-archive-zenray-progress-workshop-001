.zrt-scene{position:relative;min-height:calc(100vh - 150px);display:grid;place-items:center;font-family:var(--zr-police-sans);will-change:transform}.zrt-particules{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3}.zrt-centre{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:18px}.zrt-entete{display:flex;align-items:center;gap:12px}.zrt-titre-section{font-size:12px;font-weight:300;letter-spacing:.14em;text-transform:uppercase;color:var(--g9-muted)}.zrt-son{width:30px;height:30px;display:grid;place-items:center;border:0;border-radius:999px;cursor:pointer;color:var(--g9-muted);background:color-mix(in srgb,var(--g9-fg) 8%,transparent);transition:transform .14s cubic-bezier(.16,1,.3,1),background .14s ease,color .14s ease}.zrt-son:hover{transform:scale(1.08);color:var(--g9-fg);background:color-mix(in srgb,var(--g9-fg) 15%,transparent)}.zrt-son:active{transform:scale(.92)}.zrt-anneau-hote{position:relative;display:grid;place-items:center}.zrt-anneau-hote{animation:zrt-pulse .34s cubic-bezier(.16,1,.3,1)}@keyframes zrt-pulse{0%{transform:scale(1)}38%{transform:scale(1.045)}to{transform:scale(1)}}.zrt-anneau-hote.zrt-court{animation:zrt-respire 3.4s ease-in-out infinite}@keyframes zrt-respire{0%,to{transform:scale(1)}50%{transform:scale(1.018)}}.zrt-anneau-hote.zrt-fini{animation:zrt-triomphe .72s cubic-bezier(.34,1.56,.64,1)}@keyframes zrt-triomphe{0%{transform:scale(1)}30%{transform:scale(1.14) rotate(-1.5deg)}60%{transform:scale(.97) rotate(1deg)}to{transform:scale(1) rotate(0)}}.zrt-anneau{overflow:visible}.zrt-piste{stroke:color-mix(in srgb,var(--g9-fg) 12%,transparent)}.zrt-arc{stroke:url(#zrt-arc);transition:stroke-dasharray .55s cubic-bezier(.16,1,.3,1);filter:drop-shadow(0 0 6px color-mix(in srgb,var(--zrp-blue, #3b82f7) 45%,transparent))}.zrt-part{cursor:pointer;outline:none}.zrt-part path{fill:color-mix(in srgb,var(--g9-fg) 6%,transparent);stroke:var(--g9-glass-a);stroke-width:3;transition:fill .16s ease,transform .16s cubic-bezier(.34,1.56,.64,1);transform-origin:center}.zrt-part text{fill:var(--g9-muted);font-family:var(--zr-police-sans);font-size:22px;font-weight:300;pointer-events:none;transition:fill .16s ease,font-size .16s cubic-bezier(.34,1.56,.64,1)}.zrt-part:hover path{fill:color-mix(in srgb,var(--g9-fg) 13%,transparent)}.zrt-part:active path{transform:scale(.97)}.zrt-part.zrt-actif path{fill:color-mix(in srgb,var(--zrp-blue, #3b82f7) 26%,transparent)}.zrt-part.zrt-actif text{fill:var(--g9-fg);font-size:26px;font-weight:400}.zrt-part.zrt-verrou{cursor:default;opacity:.55}.zrt-part:focus-visible path{stroke:var(--zrp-blue, #3b82f7)}.zrt-parts{transform-box:fill-box;transform-origin:center;transition:opacity .35s ease,transform .35s cubic-bezier(.16,1,.3,1)}.zrt-anneau-hote.zrt-revele .zrt-parts{opacity:0;transform:scale(.82);pointer-events:none}.zrt-compte{position:absolute;pointer-events:none;font-family:var(--zr-police-serif);font-size:58px;font-weight:350;font-variant-numeric:tabular-nums;color:var(--g9-fg);text-shadow:0 2px 18px color-mix(in srgb,var(--g9-glass-a) 90%,transparent);opacity:0;transform:scale(.88);transition:opacity .35s ease,transform .45s cubic-bezier(.34,1.56,.64,1)}.zrt-anneau-hote.zrt-revele .zrt-compte{opacity:1;transform:scale(1);transition-delay:.12s}.zrt-compte.zrt-urgence{color:#ff6254;animation:zrt-bat .9s cubic-bezier(.16,1,.3,1) infinite}@keyframes zrt-bat{0%,to{transform:scale(1)}22%{transform:scale(1.11)}45%{transform:scale(1)}}.zrt-champ{width:min(440px,78vw);height:46px;padding:0 18px;border:0;border-radius:999px;outline:none;text-align:center;color:var(--g9-fg);font-family:var(--zr-police-sans);font-size:16px;font-weight:300;background:color-mix(in srgb,var(--g9-fg) 7%,transparent);transition:background .16s ease,transform .16s cubic-bezier(.34,1.56,.64,1),box-shadow .16s ease}.zrt-champ:focus{background:color-mix(in srgb,var(--g9-fg) 11%,transparent);transform:scale(1.015);box-shadow:0 0 0 2px color-mix(in srgb,var(--zrp-blue, #3b82f7) 40%,transparent)}.zrt-commandes{display:flex;align-items:center;gap:10px}.zrt-btn{height:42px;padding:0 26px;border:0;border-radius:999px;cursor:pointer;color:var(--g9-fg);background:color-mix(in srgb,var(--g9-fg) 9%,transparent);font-family:var(--zr-police-sans);font-size:15px;font-weight:300;transition:transform .16s cubic-bezier(.34,1.56,.64,1),background .16s ease,filter .16s ease}.zrt-btn:hover{transform:translateY(-2px);filter:brightness(1.1)}.zrt-btn:active{transform:translateY(0) scale(.95)}.zrt-primaire{background:var(--zrp-blue, #3b82f7);color:#fff;box-shadow:0 8px 22px -8px color-mix(in srgb,var(--zrp-blue, #3b82f7) 80%,transparent)}.zrt-primaire{animation:zrt-invite 2.6s ease-in-out infinite}@keyframes zrt-invite{0%,to{box-shadow:0 8px 22px -8px color-mix(in srgb,var(--zrp-blue, #3b82f7) 80%,transparent)}50%{box-shadow:0 10px 30px -6px color-mix(in srgb,var(--zrp-blue, #3b82f7) 95%,transparent)}}.zrt-discret{background:transparent;color:var(--g9-muted)}.zrt-discret:hover{background:color-mix(in srgb,var(--g9-fg) 8%,transparent)}.zrt-etat{min-height:20px;font-size:13px;font-weight:300;color:var(--g9-muted)}@media (prefers-reduced-motion: reduce){.zrt-anneau-hote,.zrt-anneau-hote.zrt-court,.zrt-anneau-hote.zrt-fini,.zrt-compte.zrt-urgence,.zrt-primaire{animation:none!important}.zrt-scene *,.zrt-scene{transition-duration:.01ms!important;transition-delay:0s!important}}.zrt-noyau{fill:color-mix(in srgb,var(--g9-fg) 7%,transparent);stroke:color-mix(in srgb,var(--g9-fg) 13%,transparent);stroke-width:1.2;cursor:pointer;outline:none;transform-box:view-box;transform-origin:50% 50%;transition:fill .18s ease,stroke .18s ease,transform .22s cubic-bezier(.34,1.56,.64,1)}.zrt-noyau:hover{fill:color-mix(in srgb,var(--zrp-blue, #3b82f7) 20%,transparent);stroke:color-mix(in srgb,var(--zrp-blue, #3b82f7) 55%,transparent);transform:scale(1.14)}.zrt-noyau:focus-visible{stroke:var(--zrp-blue, #3b82f7);stroke-width:2}.zrt-noyau-libre{fill:color-mix(in srgb,var(--zrp-blue, #3b82f7) 26%,transparent);stroke:color-mix(in srgb,var(--zrp-blue, #3b82f7) 48%,transparent)}.zrt-libre{position:absolute;display:flex;flex-direction:column;align-items:center;gap:6px;animation:zrt-libre-entree .26s cubic-bezier(.34,1.56,.64,1)}@keyframes zrt-libre-entree{0%{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}.zrt-libre-champ{width:150px;height:46px;padding:0 14px;border:0;border-radius:14px;outline:none;text-align:center;color:var(--g9-fg);font-family:var(--zr-police-serif);font-weight:400;font-size:26px;font-variant-numeric:tabular-nums;background:color-mix(in srgb,var(--g9-bg) 88%,transparent);box-shadow:0 0 0 1.5px color-mix(in srgb,var(--zrp-blue, #3b82f7) 45%,transparent),0 14px 34px -14px #00000080;transition:box-shadow .18s ease}.zrt-libre-aide{font-family:var(--zr-police-sans);font-weight:400;font-size:11px;color:var(--g9-muted);letter-spacing:.02em;white-space:nowrap}.zrt-libre-refus .zrt-libre-champ{box-shadow:0 0 0 1.5px #ff6254,0 14px 34px -14px #ff625480}.zrt-libre-refus .zrt-libre-aide{color:#ff6254}@media (prefers-reduced-motion: reduce){.zrt-libre{animation:none!important}.zrt-noyau{transition-duration:.01ms!important}}
