function source(url){try{return new URL(url).hostname.replace('www.','')}catch{return 'Image personnelle'}}
function mini(key){return `<div class="mini mini-${key}"><div class="mini-nav">ZenRay</div><div><div class="mini-title">Design</div><div class="mini-grid">${DATA.projects.slice(1,key==='B'?4:8).map(p=>`<img src="${p.image}" alt="">`).join('')}</div></div></div>`}
function compare(){app.innerHTML=`<main class="comparison"><div class="compare-top"><div class="wordmark">ZenRay<span>Design</span></div><div class="eyebrow">Trois directions · <span class="number">21 October 2026</span></div></div><h1>Faire de la place<br>aux images.</h1><p class="intro">Trois manières de retrouver tes références. Le même contenu réel, une collection ouverte et un projet complet pour juger chaque proposition dans son ensemble.</p><div class="directions">${Object.entries(VARIANTS).map(([key,v])=>`<article class="direction"><a class="preview-link" href="?v=${key}&view=design" data-variant="${key}" data-preview-view="design" aria-label="Explorer ${key}, ${v.name}">${PREVIEWS[key]?`<img src="${PREVIEWS[key]}" alt="Maquette ${key}, ${v.name}">`:mini(key)}</a><div class="direction-info"><span class="letter">${key}</span><div><h2>${v.name}</h2><p>${v.description}</p><a class="button" href="?v=${key}&view=design" data-variant="${key}" data-preview-view="design">Explorer ${key} <span aria-hidden="true">↗</span></a><div style="margin-top:14px;font-size:11px;display:flex;gap:18px"><a href="?v=${key}&view=collections" data-variant="${key}" data-preview-view="collections">Les collections ↗</a><a href="?v=${key}&view=project" data-variant="${key}" data-preview-view="project">Le projet complet ↗</a></div></div></div></article>`).join('')}</div><footer><div><span class="number">22</span> collections ArtStation · <span class="number">146</span> projets référencés<br>Exemple intégral : couverture + <span class="number">14</span> images de Louise Fretard.</div><span>Les maquettes se règlent avec des curseurs.<br>Choix de direction en attente.</span></footer></main>`}
function reviewBar(){return `<header class="reviewbar"><span class="review-label">Direction</span>${Object.keys(VARIANTS).map(v=>`<button class="variant" data-variant="${v}" aria-label="Direction ${v}, ${VARIANTS[v].name}" aria-pressed="${v===state.variant}">${v}</button>`).join('')}<span class="divider"></span>${[['design','Vue Design'],['collections','Collections'],['project','Exemple complet']].map(([view,label])=>`<button class="view-shortcut" data-view="${view}" aria-pressed="${state.view===view}">${label}</button>`).join('')}<span class="grow"></span><button class="plain" id="settings-open">Réglages</button><span class="divider"></span><button class="plain" data-compare>Comparer</button></header>`}
function sidebar(){return `<aside class="sidebar"><div class="wordmark">ZenRay<span>Studio</span></div><nav aria-label="Navigation principale"><button class="nav-item active" data-view="design">Design</button><button class="nav-item" data-view="collections">ArtStation <span class="number">22</span></button><button class="nav-item" data-view="project">Projet exemple</button></nav><div class="nav-label">Dans cette bibliothèque</div><nav class="secondary-nav" aria-label="Collections ArtStation">${['Likes','Castles','Environnements 3D','Chara Design','Game Design'].map(name=>`<button class="nav-item" data-collection="${name}">${name}<span class="number">${collection(name).count}</span></button>`).join('')}</nav><div class="bottom">Un espace pour regarder.<div class="profile"><span class="avatar">Z</span>ZenRay Studio</div></div></aside>`}
function breadcrumbs(){return `<div class="topline"><nav class="breadcrumbs" aria-label="Fil d’Ariane"><button data-view="design">Bibliothèque</button><span>/</span><button class="${state.view==='design'?'current':''}" data-view="design">Design</button>${state.view!=='design'?`<span>/</span><button data-view="collections" class="${state.view==='collections'?'current':''}">ArtStation</button>`:''}${state.view==='collection'?`<span>/</span><span class="current">${escapeHTML(state.collection)}</span>`:''}${state.view==='project'?'<span>/</span><span class="current">The Highway</span>':''}</nav><span class="account">ZenRay Studio</span></div>`}
function titleBlock(){const isDesign=state.view==='design',isCollections=state.view==='collections';const count=isDesign?DATA.references.length+1:isCollections?22:collection(state.collection).count;const noun=isDesign?'références':isCollections?'collections':'projets';const title=isDesign?'Design':isCollections?'ArtStation':state.collection;return `<div class="page-title"><div><h1>${escapeHTML(title)}</h1><p class="subtitle">${isDesign?'Des idées à garder, de l’espace pour créer.':isCollections?'Tes collections, une image à la fois.':'Une sélection de ta bibliothèque ArtStation.'}</p></div><div class="edition"><span class="number">${count}</span> ${noun}<br>${isDesign?'Bibliothèque personnelle':'Collection personnelle'}</div></div><div class="toolbar"><nav class="tabs" aria-label="Vues"><button class="tab ${isDesign?'active':''}" data-view="design">Toutes les références</button><button class="tab ${!isDesign?'active':''}" data-view="collections">Collections</button></nav><div class="tools"><label><span class="screen-reader">Rechercher</span><input class="search" id="search" placeholder="Rechercher…" value="${escapeHTML(state.query)}"></label><button class="add" id="add-image">+ Ajouter une image</button></div></div><div class="section-heading"><span id="result-count">${isDesign?'Références récentes':isCollections?'Toutes les collections':escapeHTML(state.collection)}</span><span>${state.variant==='B'?'Titres au survol et au clavier':'Une seule légende par image'}</span></div>`}
function itemsForView(){if(state.view==='design')return [{id:'artstation',type:'root',title:'ArtStation',count:22,image:project(collection('Castles').projects[0]).image},...DATA.references];if(state.view==='collections')return DATA.collections.map(c=>({id:c.name,type:'collection',title:c.name,count:c.count,image:c.projects.length?project(c.projects[0]).image:null}));return collection(state.collection).projects.map(id=>({...project(id),type:'project'}))}
function tile(item,index){const detail=item.type==='root'?'22 collections · 146 projets':item.type==='collection'?item.count+' '+(item.count===1?'projet':'projets'):item.type==='project'?item.author:source(item.url);const label=item.type==='root'?'Ouvrir les collections ArtStation':item.type==='collection'?'Ouvrir '+item.title:item.type==='project'&&item.id!==sample.id?'Voir '+item.title+' sur ArtStation':'Ouvrir '+item.title;return `<article class="tile"><button class="tile-button" data-item="${index}" aria-label="${escapeHTML(label)}"><div class="visual">${item.image?`<img src="${item.image}" alt="${escapeHTML(item.title)}" decoding="async">`:'<div class="empty" aria-hidden="true">H</div>'}<span class="open-mark" aria-hidden="true">${item.type==='project'&&item.id!==sample.id?'↗':'↗'}</span></div><div class="caption"><div><h2>${escapeHTML(item.title)}</h2>${item.type==='project'||item.type==='reference'?`<span class="source">${escapeHTML(detail)}</span>`:''}</div>${item.type==='collection'||item.type==='root'?`<span class="count"><span class="number">${item.count}</span> ${item.type==='root'?'collections':item.count===1?'projet':'projets'}</span>`:''}</div></button></article>`}
function renderGrid(){currentItems=itemsForView().filter(item=>[item.title,item.author].join(' ').toLocaleLowerCase().includes(state.query.toLocaleLowerCase()));document.getElementById('grid').innerHTML=currentItems.length?currentItems.map(tile).join(''):`<p class="empty-state">${state.query?'Aucune référence ne correspond à cette recherche.':'Cette collection est encore vide.'}</p>`;if(state.query)document.getElementById('result-count').innerHTML=`<span class="number">${currentItems.length}</span> résultats`}
function projectPage(){return `<header class="project-header"><img class="cover" src="${sample.image}" alt="Couverture du projet"><div><h1>${escapeHTML(sample.title)}</h1><p class="byline">Louise Fretard · Game Design</p></div></header><div class="project-intro"><span>Le projet complet · <span class="number">14</span> images + sa couverture</span><a href="${sample.url}" target="_blank" rel="noopener noreferrer">Voir sur ArtStation ↗</a></div><div class="project-images">${DATA.example.images.map((image,i)=>`<figure class="project-image"><button data-full="${i}" aria-label="Agrandir l’image ${i+1}"><img src="${image}" alt="${escapeHTML(sample.title)}, image ${i+1}" decoding="async"></button><figcaption><span class="number">${String(i+1).padStart(2,'0')}</span> / <span class="number">14</span></figcaption></figure>`).join('')}</div><p class="end-note">Fin du projet · <span class="number">14 / 14</span> images · Louise Fretard</p>`}
function render(){if(!state.variant){compare();return}app.innerHTML=reviewBar()+`<div class="layout">${sidebar()}<main class="main">${breadcrumbs()}${state.view==='project'?projectPage():titleBlock()+'<section class="grid" id="grid" aria-label="Galerie de références"></section>'}</main></div>`;if(state.view!=='project')renderGrid();document.getElementById('search')?.addEventListener('input',e=>{state.query=e.target.value;renderGrid()})}
function openImage(image,title,info){document.getElementById('lightbox-image').src=image;document.getElementById('lightbox-image').alt=title;document.getElementById('lightbox-title').textContent=title;document.getElementById('lightbox-info').innerHTML=info;document.getElementById('lightbox').showModal()}
function showSettings(){const values={...VARIANTS[state.variant],...state.settings[state.variant]};document.getElementById('sliders').innerHTML=SLIDERS.map(p=>`<label class="setting"><span>${p.label}<output class="number" id="value-${p.key}">${values[p.key]}${p.unit}</output></span><input aria-label="${p.label}" type="range" min="${p.min}" max="${p.max}" value="${values[p.key]}" data-setting="${p.key}"></label>`).join('');document.getElementById('labels').value=state.labels;document.getElementById('copy-status').textContent='';document.getElementById('settings').showModal()}
document.addEventListener('click',event=>{const target=event.target.closest('button,a');if(!target)return;if(target.dataset.variant){event.preventDefault();navigate({variant:target.dataset.variant,view:target.dataset.previewView||state.view});return}if(target.hasAttribute('data-compare')){navigate({variant:null});return}if(target.dataset.view){navigate({view:target.dataset.view});return}if(target.dataset.collection){navigate({view:'collection',collection:target.dataset.collection});return}if(target.dataset.close){document.getElementById(target.dataset.close).close();return}if(target.id==='settings-open'){showSettings();return}if(target.id==='add-image'){document.getElementById('file-input').click();return}if(target.dataset.full!==undefined){const index=Number(target.dataset.full);openImage(DATA.example.images[index],sample.title,`<p>Louise Fretard · Image <span class="image-counter">${index+1} / 14</span></p><a href="${sample.url}" target="_blank" rel="noopener noreferrer">Projet original sur ArtStation ↗</a>`);return}if(target.dataset.item!==undefined){const item=currentItems[Number(target.dataset.item)];if(item.type==='root')navigate({view:'collections'});else if(item.type==='collection')navigate({view:'collection',collection:item.title});else if(item.type==='project'){if(item.id===sample.id)navigate({view:'project'});else openImage(item.image,item.title,`<p>${escapeHTML(item.author)} · Couverture du projet</p><a href="${item.url}" target="_blank" rel="noopener noreferrer">Voir toutes les images sur ArtStation ↗</a>`)}else openImage(item.image,item.title,`<p>${escapeHTML(item.note||'Référence de ta bibliothèque')}</p>${item.url?`<a href="${escapeHTML(item.url)}" target="_blank" rel="noopener noreferrer">Ouvrir la source ↗</a>`:''}`)}});
document.getElementById('settings').addEventListener('input',event=>{const key=event.target.dataset.setting;if(!key)return;state.settings[state.variant]??={};state.settings[state.variant][key]=Number(event.target.value);const param=SLIDERS.find(p=>p.key===key);document.getElementById('value-'+key).textContent=event.target.value+param.unit;applyTokens()});
document.getElementById('labels').addEventListener('change',event=>{state.labels=event.target.value;applyTokens()});
document.getElementById('reset').addEventListener('click',()=>{state.settings[state.variant]={};state.labels='default';document.getElementById('settings').close();applyTokens();showSettings()});
document.getElementById('copy').addEventListener('click',async()=>{const text=JSON.stringify({direction:state.variant,name:VARIANTS[state.variant].name,parameters:{...Object.fromEntries(SLIDERS.map(p=>[p.key,VARIANTS[state.variant][p.key]])),...state.settings[state.variant]},labels:state.labels},null,2);try{await navigator.clipboard.writeText(text);document.getElementById('copy-status').textContent='Réglages copiés. Tu peux les coller dans la conversation.'}catch{document.getElementById('copy-status').textContent=text}});
document.getElementById('file-input').addEventListener('change',event=>{for(const file of event.target.files){if(file.type.startsWith('image/'))DATA.references.unshift({id:'local-'+file.name,type:'reference',title:file.name,image:URL.createObjectURL(file),url:'',note:'Image ajoutée dans cette maquette uniquement.'})}navigate({view:'design'});event.target.value=''});
window.addEventListener('popstate',readRoute);readRoute();
</script></body></html>
