function navigate(patch){state={...state,...patch,query:''};const query=new URLSearchParams();if(state.variant){query.set('v',state.variant);query.set('view',state.view);if(state.view==='collection')query.set('collection',state.collection)}history.pushState({},'',location.pathname+(query.size?'?'+query:''));applyTokens();render();window.scrollTo({top:0,behavior:'instant'})}
