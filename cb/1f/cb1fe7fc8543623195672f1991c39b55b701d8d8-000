<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- E8 mobile : app installable (écran d'accueil iOS), barre d'état adaptée, safe-area via viewport-fit=cover. -->
    <!-- LES DEUX NOMS COEXISTENT, ET C'EST VOULU (2026-08-21) : `apple-mobile-web-app-capable` est le nom
         historique, le SEUL que Safari iOS lit encore aujourd'hui — le retirer casserait l'installation sur
         iPhone. `mobile-web-app-capable` est le nom standardisé depuis, celui que Chrome lit et réclame en
         console. Tant que Safari n'aura pas rattrapé le standard, garder les deux est la seule façon d'être
         correct partout ; en garder un seul, c'est choisir quelle plateforme casser. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ZenRay" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="ZenRayProgress — LifeOS de Matthieu Huguet : objectifs, séquence de cartes et agenda hebdomadaire, persistant." />
    <title>ZenRayProgress</title>
    <!-- Perf chargement : DNS/TLS anticipés vers les CDN data/médias + preload des 2 polices critiques (réduit FOUT/FOIT). -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <link rel="dns-prefetch" href="https://api.github.com" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/InterVariable.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/AnthropicSerif-Romans.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/AnthropicSans-Romans.woff2" />
    <style>
      /* ── Design System Liquid Glass / Finder white (Phase 0 OS) ── */
      :root{
        /* CLAIR — fond off-white #FDFDFC (jamais blanc pur), surfaces frosted translucides par-dessus le wallpaper */
        --zr-bg-window:#EDEDEB; --zr-bg-content:#FDFDFC; --zr-bg-sidebar:rgba(248,248,246,0.72);
        --zr-glass-bg:rgba(253,253,252,0.62); --zr-glass-bg-strong:rgba(253,253,252,0.80);
        --zr-glass-filter:blur(28px) saturate(200%); --zr-glass-filter-thick:blur(44px) saturate(210%);
        --zr-clear-bg:rgba(255,255,255,0.10); --zr-clear-filter:blur(12px) saturate(140%); --zr-clear-dim:rgba(0,0,0,0.55);
        --zr-edge-top:inset 0 1px 0 rgba(255,255,255,0.70); --zr-edge-ring:inset 0 0 0 0.5px rgba(255,255,255,0.55);
        --zr-hairline:0.5px solid rgba(0,0,0,0.10);
        --zr-shadow-panel:0 8px 30px rgba(0,0,0,0.12); --zr-shadow-pop:0 12px 40px rgba(0,0,0,0.18),0 2px 8px rgba(0,0,0,0.08);
        --zr-shadow-overlay:0 24px 80px rgba(0,0,0,0.28),0 8px 24px rgba(0,0,0,0.14);
        --zr-r-chip:7px; --zr-r-control:10px; --zr-r-panel:14px; --zr-r-window:22px;
        --zr-accent:#0A84FF; --zr-accent-soft:rgba(10,132,255,0.12); --zr-selection:rgba(0,122,255,0.16);
        /* Tokens texte/contenu utilisés par .md-body — DOIVENT basculer en sombre */
        --bg:#FDFDFC; --fg:#1F1F1E; --muted:#6b6b67; --border:#e6e6e2;
        --code:rgba(120,120,128,0.10); --acc:#0A84FF;
      }
      /* SOMBRE — fond off-black #1F1F1E (jamais noir pur), texte off-white, surfaces frosted translucides conservées */
      .zr-dark{
        --zr-bg-window:#262624; --zr-bg-content:#1F1F1E; --zr-bg-sidebar:rgba(31,31,30,0.72);
        --zr-glass-bg:rgba(31,31,30,0.58); --zr-glass-bg-strong:rgba(31,31,30,0.80);
        --zr-edge-top:inset 0 1px 0 rgba(255,255,255,0.08); --zr-edge-ring:inset 0 0 0 0.5px rgba(255,255,255,0.07);
        --zr-hairline:0.5px solid rgba(255,255,255,0.10);
        --bg:#1F1F1E; --fg:#ECECEA; --muted:#9a9a96; --border:#3a3a38;
        --code:rgba(255,255,255,0.07); --acc:#409CFF;
      }
      /* Fond ambiant : le verre a besoin de quelque chose à réfracter, sinon l'effet est invisible (blanc/blanc). */
      :root{--zr-police-titre:var(--zr-police-sans);--zr-police-mono:ui-monospace,SFMono-Regular,'SF Mono',Menlo,'Hiragino Sans W4','AnthropicMono',monospace;--zr-police-serif:'AnthropicSerif','Hiragino Mincho ProN W3',Georgia,'Times New Roman',serif;--zr-police-sans:'Inter','Inter Variable','Hiragino Sans W4','Hiragino Sans',-apple-system,Arial,sans-serif;--zr-corps-editeur:17px;--zr-ui-base:14px;--zr-ui-3xs:calc(var(--zr-ui-base)*0.69);--zr-ui-2xs:calc(var(--zr-ui-base)*0.77);--zr-ui-xs:calc(var(--zr-ui-base)*0.85);--zr-ui-sm:calc(var(--zr-ui-base)*0.92);--zr-ui-md:var(--zr-ui-base);--zr-ui-lg:calc(var(--zr-ui-base)*1.08);--zr-ui-xl:calc(var(--zr-ui-base)*1.13);--zr-ui-2xl:calc(var(--zr-ui-base)*1.20);--zr-ui-3xl:calc(var(--zr-ui-base)*1.33);--zr-corps-poids:450;--zr-titre-poids:600;--zr-echelle-1:2.00;--zr-echelle-2:1.58;--zr-echelle-3:1.28;--zr-echelle-4:1.10;--zr-titre-1:calc(var(--zr-corps-editeur)*var(--zr-echelle-1));--zr-titre-2:calc(var(--zr-corps-editeur)*var(--zr-echelle-2));--zr-titre-3:calc(var(--zr-corps-editeur)*var(--zr-echelle-3));--zr-titre-4:calc(var(--zr-corps-editeur)*var(--zr-echelle-4));--zr-corps-table:calc(var(--zr-corps-editeur)*0.85)}
      html,body{margin:0;color:#1F1F1E;font-family:var(--zr-police-sans),Arial,sans-serif;min-height:100vh}
      .zr-dark{color:#ECECEA}
      /* Wallpaper en BACKDROP flouté + voile léger : le verre réfracte une photo douce, jamais l'image brute. */
      body{background:#e7eaf2;position:relative;isolation:isolate}
      body::before{content:"";position:fixed;inset:-8%;z-index:-2;
        background:url('/wallpaper.webp') center/cover no-repeat;
        filter:blur(34px) saturate(118%) brightness(1.04);transform:scale(1.08)}
      body::after{content:"";position:fixed;inset:0;z-index:-1;
        background:linear-gradient(180deg, rgba(236,239,244,0.30), rgba(226,231,240,0.42))}
      body:has(.zr-dark)::after{background:linear-gradient(180deg, rgba(31,31,30,0.58), rgba(28,28,27,0.68))}
      .zr-glass{background:var(--zr-glass-bg);backdrop-filter:var(--zr-glass-filter);-webkit-backdrop-filter:var(--zr-glass-filter);box-shadow:var(--zr-edge-top),var(--zr-edge-ring),var(--zr-shadow-panel)}
      .zr-glass-thick{background:var(--zr-glass-bg-strong);backdrop-filter:var(--zr-glass-filter-thick);-webkit-backdrop-filter:var(--zr-glass-filter-thick);box-shadow:var(--zr-edge-top),var(--zr-edge-ring),var(--zr-shadow-pop)}
      .zr-content{background:var(--zr-bg-content)}
      @keyframes zrNotifIn{from{opacity:0;transform:translateX(18px) scale(.97)}to{opacity:1;transform:none}}
      @keyframes zrNotifOut{from{opacity:1;transform:none}to{opacity:0;transform:translateX(18px) scale(.97)}}
      @keyframes zrIndeterminate{0%{left:-38%}100%{left:100%}}
      @keyframes zrQlIn{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:none}}
      @keyframes zrQlOut{from{opacity:1;transform:none}to{opacity:0;transform:scale(.88)}}
      @keyframes zrShareIn{from{opacity:0;transform:translateX(calc(var(--zr-dir,0) * 28px)) scale(.985)}to{opacity:1;transform:none}}
      @keyframes zrShareOut{from{opacity:1;transform:none}to{opacity:0;transform:translateX(calc(var(--zr-dir,0) * -28px)) scale(.985)}}
      @keyframes zrQlFadeIn{from{opacity:0}to{opacity:1}}
      @keyframes zrQlFadeOut{from{opacity:1}to{opacity:0}}
      .zr-notif{animation:zrNotifIn .3s cubic-bezier(.2,.7,.3,1)}
      .zr-notif-out{animation:zrNotifOut .3s ease forwards;pointer-events:none}
      .zr-quicklook-backdrop{background:var(--zr-clear-dim);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
      .zr-quicklook-chrome{background:var(--zr-clear-bg);backdrop-filter:var(--zr-clear-filter);-webkit-backdrop-filter:var(--zr-clear-filter);box-shadow:var(--zr-edge-ring),var(--zr-shadow-overlay)}
      @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.zr-glass,.zr-glass-thick{background:var(--zr-glass-bg-strong)}}
      @media (prefers-reduced-transparency:reduce){.zr-glass,.zr-glass-thick,.zr-quicklook-chrome{background:var(--zr-bg-content);backdrop-filter:none;-webkit-backdrop-filter:none}}
      button{transition:background .12s ease,color .12s ease,border-color .12s ease,box-shadow .12s ease}
      .zr-navitem:hover,.zr-treeitem:hover{background:rgba(128,128,128,0.12)!important}
      /* Fonts Anthropic : Serif = contenu (80%), Mono = code/chiffres (5%), Sans = chrome UI (15%) */
      .bn-container,.bn-editor,.bn-editor .bn-inline-content,.bn-editor p,.bn-editor h1,.bn-editor h2,.bn-editor h3,.bn-editor li{font-family:var(--zr-police-serif),Georgia,'Times New Roman',serif !important;letter-spacing:-0.01em}
      /* PLACEHOLDER « lettre par lettre » (2026-06-21) : le placeholder natif de BlockNote (::after, texte insécable)
         est MASQUÉ (transparent) ; on le remplace par un overlay React où chaque lettre est un <span class=zr-ph-letter>
         avec un animation-delay négatif décalé -> une vague d'opacité (fade in/out) traverse le texte, fluide à 60 fps
         (l'animation d'opacité tourne sur le compositeur). Voir PageEditorBN.jsx / Articles.jsx. */
      /* Éditeurs SANS overlay (ex. Articles) : placeholder natif visible en NOIR (clair) / clair (sombre). */
      .bn-editor .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after,
      .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after{color:#1F1F1E!important;-webkit-text-fill-color:#1F1F1E!important;opacity:1!important}
      .zr-dark .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after{color:rgba(236,236,234,0.62)!important;-webkit-text-fill-color:rgba(236,236,234,0.62)!important}
      /* Éditeur AVEC overlay (.zr-ph-custom = PageEditorBN) : on masque le natif, l'overlay React prend le relais. */
      .zr-ph-custom .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after{color:transparent!important;-webkit-text-fill-color:transparent!important}
      .zr-ph-letter{opacity:.45;animation:zr-ph-letter 2.4s linear infinite;will-change:opacity}
      @keyframes zr-ph-letter{0%{opacity:.45}50%{opacity:1}100%{opacity:.45}}
      @media (prefers-reduced-motion:reduce){.zr-ph-letter{animation:none!important;opacity:.6!important}}
      /* Placeholder « Enter text or type… » EN NOIR (clair) — CATCH-ALL de TOUTES les occurrences. BlockNote/
         ProseMirror l'injecte via plusieurs mécanismes : [data-is-empty-and-focused], [data-is-only-empty-block],
         [data-placeholder], .is-empty/.is-editor-empty (ProseMirror), sur le bloc OU sur .bn-inline-content,
         focus ou non. On les couvre toutes. Dark = gris clair lisible (override après). */
      .bn-editor [data-is-empty-and-focused]::before,
      .bn-editor [data-is-empty-and-focused] .bn-inline-content::before,
      .bn-editor [data-is-only-empty-block]::before,
      .bn-editor [data-is-only-empty-block] .bn-inline-content::before,
      .bn-editor [data-placeholder]::before,
      .bn-editor .bn-inline-content[data-placeholder]::before,
      .bn-editor .ProseMirror .is-empty::before,
      .bn-editor .ProseMirror .is-editor-empty::before,
      .bn-editor .ProseMirror p.is-empty:first-child::before{color:#1F1F1E!important;-webkit-text-fill-color:#1F1F1E!important;opacity:1!important}
      .zr-dark .bn-editor [data-is-empty-and-focused]::before,
      .zr-dark .bn-editor [data-is-empty-and-focused] .bn-inline-content::before,
      .zr-dark .bn-editor [data-is-only-empty-block]::before,
      .zr-dark .bn-editor [data-is-only-empty-block] .bn-inline-content::before,
      .zr-dark .bn-editor [data-placeholder]::before,
      .zr-dark .bn-editor .bn-inline-content[data-placeholder]::before,
      .zr-dark .bn-editor .ProseMirror .is-empty::before,
      .zr-dark .bn-editor .ProseMirror .is-editor-empty::before{color:rgba(235,235,235,0.55)!important;-webkit-text-fill-color:rgba(235,235,235,0.55)!important}
      .bn-editor h1,.bn-editor h2,.bn-editor h3{font-weight:600 !important;letter-spacing:-0.02em}
      .bn-editor code,.bn-editor pre,.bn-editor [data-content-type="codeBlock"] *{font-family:var(--zr-police-mono) !important}
      /* Aucune boite blanche : l'editeur est transparent (pose sur la scene frosted), texte normal = aucun fond. */
      .bn-container,.bn-editor,.bn-editor .bn-block-content,.bn-editor .bn-block-group{background:transparent !important;box-shadow:none !important}
      /* Bloc /code facon Notion : UNE seule boite grise arrondie, texte sombre monospace. On force le fond
         UNIQUEMENT sur le conteneur codeBlock (le pre/code interne transparent -> pas de double boite),
         et la couleur du texte en off-black (clair) / off-white (sombre) -> jamais de texte blanc illisible. */
      .bn-editor [data-content-type="codeBlock"]{background:rgba(120,120,128,0.10) !important;border:none !important;border-radius:10px !important;padding:14px 16px !important}
      .bn-editor [data-content-type="codeBlock"] pre,.bn-editor [data-content-type="codeBlock"] code{background:transparent !important;border:none !important;border-radius:0 !important;padding:0 !important;box-shadow:none !important}
      .bn-editor [data-content-type="codeBlock"],.bn-editor [data-content-type="codeBlock"] *{color:#1F1F1E !important}
      .zr-dark .bn-editor [data-content-type="codeBlock"]{background:rgba(255,255,255,0.06) !important}
      .zr-dark .bn-editor [data-content-type="codeBlock"],.zr-dark .bn-editor [data-content-type="codeBlock"] *{color:#ECECEA !important}
      /* Code inline = petite puce grise, texte sombre. */
      .bn-editor code:not([data-content-type="codeBlock"] code){background:rgba(120,120,128,0.13) !important;border:none !important;border-radius:4px !important;padding:.08em .35em !important;color:#1F1F1E !important}
      .zr-dark .bn-editor code:not([data-content-type="codeBlock"] code){color:#ECECEA !important}
      /* Sélection multi-blocs au marquee (façon Notion) : fond plein bleu sur chaque bloc sélectionné. */
      .bn-block-outer.zr-bn-blockselected > .bn-block{background:rgba(10,132,255,0.16);border-radius:6px}
      ::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-thumb{background:rgba(128,128,128,0.28);border-radius:8px;border:2px solid transparent;background-clip:content-box}::-webkit-scrollbar-track{background:transparent}
      .md-body{font-family:var(--zr-police-serif),Georgia,'Times New Roman',serif;color:var(--fg);line-height:1.6;font-size:15.5px;letter-spacing:-0.01em;max-width:820px}
      .md-body h1,.md-body h2,.md-body h3,.md-body h4,.md-body h5,.md-body h6{font-family:var(--zr-police-serif),Georgia,serif;font-weight:var(--zr-titre-poids);letter-spacing:-0.02em;line-height:1.22;margin:1.4em 0 .5em}
      .md-body h1{font-size:var(--zr-titre-1)} .md-body h2{font-size:var(--zr-titre-2)} .md-body h3{font-size:var(--zr-titre-3)} .md-body h4{font-size:var(--zr-titre-4)}
      .md-body h5,.md-body h6{font-size:var(--zr-corps-editeur)}
      .md-body h1,.md-body h2{border-bottom:1px solid var(--border);padding-bottom:.3em}
      .md-body p{margin:.7em 0}
      .md-body a{color:var(--acc);text-decoration:none} .md-body a:hover{text-decoration:underline}
      .md-body code{font-family:var(--zr-police-mono);background:var(--code);border:1px solid var(--border);border-radius:5px;padding:.1em .4em;font-size:.88em}
      .md-body pre{background:var(--code);border:1px solid var(--border);border-radius:10px;padding:14px;overflow:auto}
      .md-body pre code{background:none;border:none;padding:0}
      .md-body blockquote{border-left:3px solid var(--acc);margin:.8em 0;padding:.2em 0 .2em 14px;color:var(--muted);font-style:italic}
      .md-body table{border-collapse:collapse;width:100%;margin:1em 0;font-size:var(--zr-corps-table)}
      .md-body th,.md-body td{border:1px solid rgba(0,0,0,0.32);padding:7px 10px;text-align:left}
      .md-body th{background:var(--code)}
      .zr-dark .md-body th,.zr-dark .md-body td{border-color:rgba(255,255,255,0.26)}
      /* Tables de l'editeur BlockNote : bordure par defaut #ddd (lit blanc sur carte claire) -> gris franc.
         !important car la CSS BlockNote est injectee apres ce \3c style>. */
      .bn-editor [data-content-type=table] th,.bn-editor [data-content-type=table] td{border-color:rgba(0,0,0,0.32)!important}
      .zr-dark .bn-editor [data-content-type=table] th,.zr-dark .bn-editor [data-content-type=table] td{border-color:rgba(255,255,255,0.26)!important}
      .md-body img{max-width:100%;border-radius:8px}
      .md-body ul,.md-body ol{padding-left:1.3em} .md-body li{margin:.25em 0}
      .md-body li input[type=checkbox]{margin-right:8px;transform:translateY(1px)}
      .md-body li:has(input[type=checkbox]){list-style:none;margin-left:-1.1em}
      .md-body hr{border:none;border-top:1px solid var(--border);margin:1.6em 0}

      /* ── RESPONSIVE (C217) : mobile <640 · tablette 640-1024 · desktop >1024 ── */
      /* Sidebar en OVERLAY sous 860px : flotte par-dessus le contenu, ne le pousse pas. */
      .zr-sidebar-overlay{position:fixed !important;top:0;left:0;height:100dvh !important;z-index:120;
        box-shadow:var(--zr-shadow-overlay);animation:zr-slide-in .22s cubic-bezier(.22,.61,.36,1);
        /* MOBILE : panneau quasi opaque (pas le verre translucide a 58%), sinon il "floute tout" le contenu au
           lieu d'etre un panneau lisible. Blur leger garde le grain liquid glass sans jank ni transparence. */
        background:var(--zr-bg-content) !important;backdrop-filter:blur(10px) saturate(180%) !important;-webkit-backdrop-filter:blur(10px) saturate(180%) !important}
      .zr-sidebar-overlay::before{opacity:.6}
      .zr-sidebar-backdrop{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,0.32);
        backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);animation:zr-fade-in .2s ease}
      @keyframes zr-slide-in{from{transform:translateX(-100%)}to{transform:translateX(0)}}
      @keyframes zr-fade-in{from{opacity:0}to{opacity:1}}

      /* Drawers latéraux du Finder (favoris / inspecteur) sur écran étroit */
      .zr-drawer-backdrop{position:fixed;inset:0;z-index:130;background:rgba(0,0,0,0.32);
        backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);animation:zr-fade-in .2s ease}

      /* P4 — zones qui scrollent dans un panneau en verre : on coupe le blur (recompose à chaque frame = jank mobile),
         fond opaque fort à la place. Posée sur les conteneurs overflowY:auto des drawers + sidebar overlay. */
      .zr-scroll-noblur{backdrop-filter:none !important;-webkit-backdrop-filter:none !important;background:var(--zr-glass-bg-strong) !important}
      .zr-path-columns-scroll::-webkit-scrollbar{display:none}
      .zr-liquid-normal::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;z-index:2;
        background:linear-gradient(135deg,rgba(255,255,255,.92),rgba(255,255,255,.24) 42%,rgba(0,0,0,.10));
        -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
        mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}

      /* Tablette + mobile : zones de tap confortables (>=40px), pas de hover-only. */
      /* Tile Finder (GLOBAL, desktop inclus) : l'icône/vignette (img/svg) ne doit JAMAIS intercepter le clic
         ni démarrer un drag d'image natif. Sinon, en desktop, le clic/double-clic atterrit sur l'icône et le
         dossier ne s'ouvre pas (il fallait cliquer à côté). On rend ces éléments transparents aux pointeurs :
         tous les clics/double-clics atteignent le <button> de la tuile ; le drag du tile (porté par le bouton)
         continue de fonctionner. Cette règle était à tort confinée au @media mobile -> sortie en global. */
      .zr-treeitem img,.zr-treeitem svg{pointer-events:none;-webkit-user-drag:none;user-select:none}
      @media (max-width:1024px){
        .zr-tap{min-height:40px;display:flex;align-items:center;justify-content:center}
        .zr-treeitem,.zr-navitem{min-height:38px;display:flex;align-items:center}
        /* P3 — sur tactile, révéler les actions normalement cachées au hover (classe dédiée, pas un guess de style inline) */
        .zr-hover-action{visibility:visible !important;opacity:1 !important}
      }

      /* Mobile <640 : feuille blanche pleine largeur, marges réduites, md plus lisible. */
      @media (max-width:640px){
        .zr-content{border-radius:var(--zr-r-control) !important}
        .md-body{max-width:100%}
        /* scrollbars natives (overlay iOS) plus discrètes */
        ::-webkit-scrollbar{width:6px;height:6px}
      }

      /* Toolbars qui débordent : wrap propre partout (Finder, sections, onglets). */
      @media (max-width:860px){
        .zr-wrap{flex-wrap:wrap !important;row-gap:8px !important}
      }

      @media (prefers-reduced-motion:reduce){
        .zr-sidebar-overlay,.zr-sidebar-backdrop,.zr-drawer-backdrop{animation:none}
