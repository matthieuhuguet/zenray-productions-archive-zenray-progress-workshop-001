/** Octets en gigaoctets lisibles, ou en mégaoctets sous le gigaoctet. */
const go = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(2)} Go` : `${Math.round(n / 1e6)} Mo`)
/** LA POLITIQUE DE DÉCOUPAGE EST EN MÉBI-OCTETS, pas en méga : 95 Mio valent 99,6 millions d'octets, donc
 *  l'afficher en « Mo » donnait « 100 Mo » et laissait croire que la règle des 95 était violée. On affiche donc
 *  dans l'unité où la règle est écrite. */
const mio = (n: number) => `${Math.round(n / 1048576)} Mio`

