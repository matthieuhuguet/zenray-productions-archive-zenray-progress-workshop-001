#!/bin/zsh
# CONSTRUIT ET EMBARQUE L'EXTENSION FINDER DANS ZenRayCloud.app.
#
# Une extension FinderSync est un bundle `.appex` posé dans `Contents/PlugIns` de l'app hôte. macOS ne la charge
# que si l'app ET l'extension sont signées ; une signature ad hoc suffit pour un usage local, sans certificat de
# développeur. C'est aussi pour cela que la signature se fait ICI, après l'empaquetage d'electron-builder, qui
# laisse l'app non signée.
set -e
cd "$(dirname "$0")"

APP="../release/mac-arm64/ZenRayCloud.app"
[[ -d "$APP" ]] || { echo "app introuvable : construire d'abord avec « npm run app »" >&2; exit 1 }

APPEX="$APP/Contents/PlugIns/ZenRayCloudFinder.appex"
rm -rf "$APPEX"
mkdir -p "$APPEX/Contents/MacOS" "$APPEX/Contents/Resources"

cat > "$APPEX/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>fr</string>
  <key>CFBundleDisplayName</key><string>ZenRayCloud</string>
  <key>CFBundleExecutable</key><string>ZenRayCloudFinder</string>
  <key>CFBundleIdentifier</key><string>com.zenray.cloud.finder</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>ZenRayCloudFinder</string>
  <key>CFBundlePackageType</key><string>XPC!</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionAttributes</key>
    <dict><key>NSExtensionServiceAllowsFinderSyncBadging</key><true/></dict>
    <key>NSExtensionPointIdentifier</key><string>com.apple.FinderSync</string>
    <key>NSExtensionPrincipalClass</key><string>ZenRayCloudFinder.FinderSync</string>
  </dict>
</dict>
</plist>
PLIST

# Compilation directe par swiftc : pas de projet Xcode à maintenir pour cent trente lignes.
swiftc -O -target arm64-apple-macos12.0 \
  -module-name ZenRayCloudFinder \
  -framework Cocoa -framework FinderSync \
  -o "$APPEX/Contents/MacOS/ZenRayCloudFinder" \
  ZenRayCloudFinder/FinderSync.swift

# La signature ad hoc, de l'intérieur vers l'extérieur : l'extension d'abord, l'app ensuite.
codesign --force --sign - --timestamp=none "$APPEX"
codesign --force --deep --sign - --timestamp=none "$APP" 2>/dev/null || codesign --force --sign - "$APP"

# On présente l'app à macOS pour qu'il découvre l'extension, puis on l'active.
pluginkit -a "$APPEX" 2>/dev/null || true
pluginkit -e use -i com.zenray.cloud.finder 2>/dev/null || true

echo "extension embarquée et activée."
pluginkit -m -i com.zenray.cloud.finder || echo "(non listée : ouvrir Réglages Système > Général > Éléments de connexion > Extensions > Finder)"
