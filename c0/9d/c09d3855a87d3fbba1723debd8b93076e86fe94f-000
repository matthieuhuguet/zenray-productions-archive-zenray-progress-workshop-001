import { link, rm } from 'node:fs/promises'
import path from 'node:path'

export function restorationCandidate(basePath, occurrence) {
  if (occurrence === 1) return basePath
  const parsed = path.parse(basePath)
  return path.join(parsed.dir, `${parsed.name} (${occurrence})${parsed.ext}`)
}

// 3 October 2026, 09:34 CEST: managed identities reject collisions while standalone downloads retain their existing rename policy.
export async function publishRestoreWithoutOverwrite(temporaryPath, requestedPath, { onConflict = 'rename' } = {}) {
