// Link an existing Create media using the same helper as the Calendar composer. (19 October 2026, 01:16 Paris)
import { readFile, writeFile } from 'node:fs/promises'
import { linkCreateAttachment } from '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/create/linkCreateAttachment.js'
import { saveJsonWithRetry } from '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/lib/saveJson.js'
import { DEFAULT_PARAMS } from '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/workers/plan-gcal/src/params.js'
const params = { site: DEFAULT_PARAMS.runtime.siteUrl, plan: DEFAULT_PARAMS.runtime.planPath,
  path: process.argv[2], date: process.argv[3], receipt: process.argv[4] }
if (!params.path || !params.date || !params.receipt || !process.env.ZR_API_SECRET) throw new Error('Usage: script <Create path> <date> <receipt>, with ZR_API_SECRET')
const nativeFetch = globalThis.fetch
let calls = []
globalThis.fetch = async (input, options = {}) => {
  const url = new URL(input, params.site), headers = new Headers(options.headers)
  if (url.origin === params.site) headers.set('x-zr-auth', process.env.ZR_API_SECRET)
  calls.push({ method: options.method || 'GET', path: url.pathname, action: options.body ? JSON.parse(options.body).action : url.searchParams.get('action') })
  return nativeFetch(url, { ...options, headers })
}
const taskId = 'create-kamikaze-girls-' + params.date
let receipt
try { receipt = JSON.parse(await readFile(params.receipt, 'utf8')) } catch {}
if (!receipt) {
  const attachment = await linkCreateAttachment(params.path, { origin: params.site })
  receipt = { taskId, date: params.date, attachment }
  await writeFile(params.receipt, JSON.stringify(receipt, null, 2))
}
const result = await saveJsonWithRetry(params.plan, (board) => {
  if (!board.tasks?.length) throw new Error('Refusing to replace an empty or unreadable Plan')
  if (board.tasks.some((task) => task.id === taskId)) return board
  return { ...board, tasks: [...board.tasks, { id: taskId, title: 'Kamikaze Girls (2004)', date: params.date,
    startTime: null, durationMin: null, status: 'planned', note: '', images: [], attachments: [receipt.attachment],
    overdueSince: null, doneAt: null, createdAt: new Date().toISOString() }] }
})
if (!result.ok) throw new Error(result.error)
receipt.calls = calls
receipt.taskCount = result.data.tasks.length
await writeFile(params.receipt, JSON.stringify(receipt, null, 2))
console.log(JSON.stringify({ taskId, title: receipt.attachment.name, url: receipt.attachment.url, bytesUploaded: 0, taskCount: receipt.taskCount, calls }, null, 2))
