              <div>
                <label>Silence avant envoi (secondes)</label>
                <input className="champ" type="number" min={5} defaultValue={prefs.debounceSec}
                  onBlur={(e) => window.zrc.setPrefs({ debounceSec: Number(e.target.value) }).then(setEtat)} />
              </div>
              <div>
                <label>Balayage de rattrapage (heures)</label>
                <input className="champ" type="number" min={1} defaultValue={prefs.fullScanHours}
                  onBlur={(e) => window.zrc.setPrefs({ fullScanHours: Number(e.target.value) }).then(setEtat)} />
              </div>
              <div style={{ gridColumn: '1 / -1', display: 'flex', alignItems: 'center', gap: 8 }}>
                <input id="login" type="checkbox" defaultChecked={prefs.launchAtLogin}
                  onChange={(e) => window.zrc.setPrefs({ launchAtLogin: e.target.checked }).then(setEtat)} />
                <label htmlFor="login" style={{ margin: 0 }}>Lancer au démarrage de la session</label>
              </div>
              <div style={{ gridColumn: '1 / -1', color: 'var(--gris)', fontSize: 12 }}>
                node : <code>{prefs.nodePath || 'introuvable'}</code> · gh : <code>{prefs.ghPath || 'introuvable'}</code>
              </div>
            </div>
          </div>
        )}

        {!folders.length && <div className="vide">Ajoute un dossier : il sera surveillé, puis poussé sur le drive dès qu'il cesse de bouger.</div>}

        {folders.map((f) => {
          const r = runtime[f.id]
          const st = r?.status || 'idle'
          const p = r?.progress
          const fiches = etat.fiches?.[f.id] || []
          const connus = fiches.length
          // TOUT CE QUI EST SAUVEGARDÉ N'EST PLUS FORCÉMENT SUR LE MAC, et compter les deux ensemble
          // remettait le rapport à cent pour cent : l'index portait 13 991 fiches pour un dossier qui ne
          // contient plus que 13 942 fichiers, les 49 autres ayant quitté le Mac. Leurs manifestes restent en
          // ligne — une sauvegarde n'efface rien — mais ils n'appartiennent plus au dossier qu'on mesure.
          const surLeMac = fiches.filter((x: any) => x.local).length
          const partis = connus - surLeMac
          // UN RAPPORT DONT LE DÉNOMINATEUR SUIT LE NUMÉRATEUR AFFICHE TOUJOURS CENT POUR CENT, et c'est
          // exactement ce qui se produisait : `p.total` recevait, pendant la vérification, le nombre de
          // morceaux contrôlés, lequel valait `seen`. On prend donc la taille du dossier relevée à
          // l'inventaire, seul instant où ce chiffre compte bien des fichiers.
          // Au repos, `p` n'existe plus : sans la mémoire du dernier inventaire, le rapport retombait sur
          // `connus / connus`, donc cent pour cent, y compris quand le dernier passage avait laissé des
          // fichiers de côté. Le bilan garde donc la taille du dossier.
          const totalDossier = Math.max(surLeMac, p?.fichiersDossier || 0, r?.bilan?.fichiersDossier || 0)
          const pct = totalDossier ? Math.min(100, surLeMac / totalDossier * 100) : 0
          const R = 26, C = 2 * Math.PI * R
          const menu = menuOuvert === f.id
          const rst = p ? resteEstime(p) : null
          return (
            <div className="carte" key={f.id}>
              {/* ── EN-TÊTE : qui, d'où vers où, et les gestes ─────────────────────────────────────
                  Le chemin de destination reste MODIFIABLE comme depuis le premier jour ; il passe d'un
                  champ toujours ouvert à un champ qui s'ouvre au clic. Rendre un réglage discret n'est
                  pas le supprimer, tant qu'un seul clic suffit à le retrouver. */}
              <div className="tete-carte">
                <div className="tete-id">
                  <span className="pastille" style={{ background: COULEUR[st] }} />
                  <div style={{ minWidth: 0 }}>
                    <div className="tete-nom">
                      {f.src.split('/').pop()}
                      <span className={`badge badge-${st}`}>{LIBELLE[st]}</span>
                    </div>
                    <div className="tete-route chemin">
                      <span title={f.src}>{f.src}</span>
                      <span className="fleche">→</span>
                      <button className="lien" onClick={() => setDestOuverte(destOuverte === f.id ? null : f.id)}>{f.dest}</button>
                    </div>
                  </div>
                </div>
                <div className="tete-actions">
                  <button className="btn primaire" onClick={() => window.zrc.sync(f.id).then(setEtat)} disabled={f.paused}>Tout synchroniser</button>
                  {st === 'syncing' && (
                    <button className="btn" onClick={() => window.zrc.geler(f.id, !gelés.has(f.id)).then((e) => {
                      setGelés((g) => { const n = new Set(g); n.has(f.id) ? n.delete(f.id) : n.add(f.id); return n }); setEtat(e)
                    })}>{gelés.has(f.id) ? 'Reprendre' : 'Geler'}</button>
                  )}
                  <button className="btn" onClick={() => window.zrc.cancel(f.id).then(setEtat)} disabled={st !== 'syncing'}>Arrêter</button>
                  <button className={`btn ${menu ? 'actif' : ''}`} onClick={() => setMenuOuvert(menu ? null : f.id)} title="Plus d'actions">···</button>
                </div>
              </div>

              {destOuverte === f.id && (
                <div className="volet">
                  <label>Destination sur le drive</label>
                  <input className="champ" defaultValue={f.dest}
                    onBlur={(e) => window.zrc.updateFolder(f.id, { dest: e.target.value }).then(setEtat)} />
                  <label className="volet-case">
                    <input type="checkbox" checked={f.markDeleted}
                      onChange={(e) => window.zrc.updateFolder(f.id, { markDeleted: e.target.checked }).then(setEtat)} />
                    marquer les suppressions — rien n'est jamais effacé en ligne, seulement daté
                  </label>
                </div>
              )}

              {/* Le menu range les gestes rares SANS en retirer un seul. */}
              {menu && (
                <div className="volet volet-menu">
                  <button className="btn" onClick={() => { setTableauOuvert(tableauOuvert === f.id ? null : f.id); setMenuOuvert(null) }}>Fichiers</button>
                  <button className="btn" onClick={() => window.zrc.updateFolder(f.id, { paused: !f.paused }).then(setEtat)}>{f.paused ? 'Reprendre la surveillance' : 'Mettre en pause'}</button>
                  <button className="btn" onClick={async () => {
                    setDrive((x) => ({ ...x, [f.id]: 'lecture du drive…' }))
                    const res = await window.zrc.etatDrive(f.id)
                    setDrive((x) => ({ ...x, [f.id]: res.message }))
                  }}>Vérifier le drive</button>
                  <button className="btn" onClick={() => { setOuvert(ouvert === f.id ? null : f.id); setMenuOuvert(null) }}>Journal</button>
                  <button className="btn" onClick={() => window.zrc.openSrc(f.id)}>Ouvrir le dossier</button>
                  <button className="btn" onClick={() => window.zrc.openDrive(f.id)}>Voir sur le drive</button>
                  <button className="btn" onClick={() => window.zrc.revealLog(f.id)}>Journal complet</button>
                  <button className="btn danger" onClick={() => { if (confirm(`Ne plus surveiller ${f.src} ?\n\nRien n'est supprimé, ni en local ni sur le drive.`)) window.zrc.removeFolder(f.id).then(setEtat) }}>Retirer</button>
                </div>
              )}

              {/* ── QUATRE TUILES : où en est-on, quel état, quelles voies, quels filtres ──────────── */}
              <div className="tuiles">
                <div className="tuile">
                  <div className="tuile-titre">Progression globale</div>
                  <div className="tuile-corps">
                    <div className="anneau" title={`${pct.toFixed(1)} % du dossier sauvegardé`}>
                      <svg viewBox="0 0 64 64" width="62" height="62" role="img">
                        <circle cx="32" cy="32" r={R} className="anneau-fond" />
                        <circle cx="32" cy="32" r={R} className="anneau-arc"
                          strokeDasharray={`${C * pct / 100} ${C}`} transform="rotate(-90 32 32)" />
                        {/* LE CHIFFRE VIT DANS LE SVG. Superposé en HTML, il se décalait dès qu'il passait à
                            trois chiffres, et le « % » tombait sous lui : une grille traite le texte et son
                            unité comme deux cellules. Dans le SVG, `text-anchor` et `dominant-baseline` le
                            centrent sur le centre géométrique du cercle, quel que soit le nombre de chiffres. */}
                        <text x="32" y="32" className="anneau-valeur" textAnchor="middle" dominantBaseline="central">
                          {pct >= 99.95 ? 100 : pct.toFixed(0)}<tspan className="anneau-unite">%</tspan>
                        </text>
                      </svg>
                    </div>
                    <div style={{ minWidth: 0 }}>
                      <div className="grand"><b className="n">{p && p.octetsParSeconde > 0 ? (p.octetsParSeconde / 1e6).toFixed(1) : '—'}</b> <span className="grand-unite">Mo/s</span></div>
                      {/* Le libellé suit la phase : pendant les empreintes le chiffre mesure une LECTURE
                          disque, et le confondre avec un envoi ferait croire à deux gigaoctets par seconde. */}
                      <div className="petit">{p?.phase === 'empreintes' ? 'lecture disque' : 'vitesse actuelle'}</div>
                      <div className="tuile-fait">
                        <span className="n">{surLeMac.toLocaleString('fr-FR')}</span> / <span className="n">{totalDossier.toLocaleString('fr-FR')}</span> fichiers sauvegardés
                      </div>
                      {/* DEUX COMPTEURS, DEUX SENS, ET LES CONFONDRE FAISAIT MENTIR LE PANNEAU. Au-dessus,
                          les fichiers dont le manifeste est EN LIGNE, seule preuve d'une sauvegarde. Ici, ceux
                          que le passage a traversés : découpés, peut-être déjà dans l'atelier, pas encore
                          publiés. L'envoi se fait par lots de morceaux, jamais fichier par fichier, si bien que
                          le second devance toujours le premier d'un lot. */}
                      {partis > 0 && <div className="petit" title="Leurs manifestes restent en ligne : une sauvegarde n'efface jamais rien.">
                        <span className="n">{partis.toLocaleString('fr-FR')}</span> encore en ligne, source retirée du Mac</div>}
                      {p && p.seen > 0 && <div className="petit"><span className="n">{p.seen.toLocaleString('fr-FR')}</span> vus dans ce passage</div>}
                      {p && p.envoyes > 0 && <div className="petit"><span className="n">{go(p.envoyes)}</span> confirmés en ligne</div>}
                    </div>
                  </div>
                </div>

                <div className="tuile">
                  <div className="tuile-titre">Statut</div>
                  <div className="statut-ligne">
                    {/* UNE COCHE VERTE À CÔTÉ DE « DERNIER PASSAGE EN ÉCHEC », c'est ce que la carte affichait :
                        `st` décrit la FILE (au repos, en cours, en attente) et non le VERDICT, si bien qu'un
                        dossier revenu au repos après un échec retrouvait sa coche verte. Le verdict prime. */}
                    <span className={`coche ${st === 'error' || (!p && f.lastError) ? 'ko' : st === 'syncing' || p ? 'encours' : 'ok'}`}>
                      {st === 'error' || (!p && f.lastError) ? '!' : '✓'}</span>
                    <b>{p ? (PHRASE[p.phase] || p.phase) : f.lastError ? 'Dernier passage en échec' : f.lastResult ? 'Synchronisation terminée' : 'Jamais synchronisé'}</b>
                  </div>
                  <div className="petit">
                    {p ? (rst === null ? 'estimation en cours' : rst < 5 ? 'dernier fichier de cette phase' : <>reste <span className="n">{duree(rst)}</span></>)
                      : r?.bilan ? <>Vérification en ligne : {r.bilan.sautes.length ? `${r.bilan.sautes.length} écarté(s)` : 'terminée'}</> : '—'}
                  </div>
                  {/* POURQUOI ÇA POUSSE ENCORE ALORS QUE LE COMPTEUR DIT 100 % (question de Matthieu,
                      2026-08-18) : le compteur ci-dessus dit « au moins une version déjà sauvegardée », pas
                      « la version d'aujourd'hui est en ligne ». Un fichier énorme qui a changé (un
                      téléchargement qui avance) reste donc à 100 % pendant qu'une NOUVELLE version de LUI SEUL
                      se pousse en arrière-plan. Nommer sa taille rend ce fait lisible d'un coup d'œil. */}
                  {p && (p.phase === 'découpe' || p.phase === 'envoi') && p.bytes >= 2e8 && (
                    <div className="petit" title={p.rel}>nouvelle version de « {p.rel.split('/').pop()} », <span className="n">{go(p.bytes)}</span></div>
                  )}
                  <div className="petit">Dernière activité : {dateCourte(f.lastRunAt ?? f.lastSyncAt)}</div>
                  {f.lastRunAt && f.lastSyncAt && f.lastRunAt !== f.lastSyncAt
                    && <div className="petit">Dernier succès complet : {dateCourte(f.lastSyncAt)}</div>}
                  {!p && f.lastError && <div className="petit ko-texte">{f.lastError}</div>}
                  {r?.reprises ? <div className="petit ko-texte">reprise automatique <span className="n">{r.reprises}</span></div> : null}
                  {/* « NON SAUVEGARDÉ » ALARMAIT À TORT. Ces fichiers-là bougeaient pendant leur lecture, très
                      souvent un téléchargement en cours : le moteur refuse de publier un contenu instable, la
                      source reste entière sur le Mac, et le passage suivant les reprend. C'est un report. */}
                  {(p?.sautes?.length || r?.bilan?.reportes?.length) ? (
                    <div className="petit" title={(p?.sautes || r?.bilan?.reportes || []).join('\n')}>
                      <span className="n">{p?.sautes?.length || r?.bilan?.reportes?.length}</span> fichier(s) reporté(s) au prochain passage
                    </div>
                  ) : null}
                </div>

                <div className="tuile">
                  <div className="tuile-titre">Voies</div>
                  <div className="grand n">{p ? `${p.voiesVivantes} / ${p.voies}` : r?.bilan ? `${r.bilan.voies}` : '—'}</div>
                  {!p && r?.bilan && <div className="petit">au dernier passage</div>}
                  {p && p.voiesVivantes < p.voies && <div className="petit ko-texte">une voie s'est arrêtée</div>}
                  <div className="tuile-titre" style={{ marginTop: 10 }}>Durée écoulée</div>
                  <div className="grand">{p ? <Chrono debut={p.debut} />
                    : r?.bilan ? <span className="n">{duree(r.bilan.secondes)}</span> : <span className="n">—</span>}</div>
                </div>

                <div className="tuile">
                  <div className="tuile-titre">Filtres</div>
                  <div className="filtres">
                    <span className="petit">Exclure</span>
                    {(f.excludes || []).filter((x) => x.trim()).map((x) => <span className="jeton" key={x}>{x.trim()}</span>)}
                    {!(f.excludes || []).filter((x) => x.trim()).length && <span className="petit">aucun</span>}
                  </div>
                  <button className="btn" style={{ marginTop: 10 }}
                    onClick={() => setFiltreOuvert(filtreOuvert === f.id ? null : f.id)}>Modifier</button>
                  {filtreOuvert === f.id && (
                    <input className="champ" style={{ marginTop: 8 }} placeholder="sous-dossiers à ignorer, séparés par des virgules"
                      defaultValue={(f.excludes || []).join(', ')}
                      onBlur={(e) => window.zrc.updateFolder(f.id, { excludes: e.target.value.split(',') }).then(setEtat)} />
                  )}
                </div>
              </div>

              {p && <Frise phase={p.phase} p={p} connus={connus} />}
              {p && <Ruban rel={p.rel} />}
              {drive[f.id] && <div className="resume drive-etat">🛰 {drive[f.id]}</div>}

              {/* ── LE PIED : dépôt, atelier, compte du passage, accès au dossier de travail ───────── */}
              {p && (
                <div className="pied">
                  <span className="pied-item">Dépôt : <b className="chemin">{p.depot || '—'}</b></span>
                  <span className="pied-item">Espace en attente : <b className="n">{go(p.atelierOctets)}</b></span>
                  <span className="pied-item">Dépôt local : <b className="n">{go(p.depotOctets)}</b></span>
                  <span className="pied-item"><span className="n">{p.seen.toLocaleString('fr-FR')}</span>/<span className="n">{p.total.toLocaleString('fr-FR')}</span> dans ce passage</span>
                  {p.morceaux ? <span className="pied-item">morceau <span className="n">{p.morceau}/{p.morceaux}</span> de <span className="n">{mio(p.tailleMorceau)}</span></span> : null}
                  {p.atelier && <button className="lien pied-lien" onClick={() => window.zrc.openAtelier(p.atelier)}>Ouvrir dans le Finder</button>}
                </div>
              )}
              {p?.morceauxEnAttente?.length ? (
                <div className="morceaux">
                  {p.morceauxEnAttente.map((m) => (
                    <span className="morceau" key={m.nom} title={m.nom}>{m.nom.slice(-11)} <b className="n">{mio(m.octets)}</b></span>
                  ))}
                </div>
              ) : null}

              {!p && r?.bilan && (
                <div className={`bilan ${r.bilan.ok ? '' : 'ko'}`}>
                  <b>{r.bilan.ok ? 'Passage terminé' : 'Passage interrompu'}</b>
                  {' · '}<span className="n">{r.bilan.fichiers}</span> fichier(s) montés
                  {' · '}<span className="n">{go(r.bilan.octets)}</span>
                  {r.bilan.octetsParSeconde > 0 ? <> · <span className="n">{(r.bilan.octetsParSeconde / 1e6).toFixed(1)}</span> Mo/s</> : ''}
                  {' · '}<span className="n">{r.bilan.voies}</span> voie(s)
                  {' · '}<span className="n">{duree(r.bilan.secondes)}</span>
                  {r.bilan.reutilises ? <> · <span className="n">{r.bilan.reutilises}</span> déplacé(s) sans transfert</> : ''}
                  {r.bilan.sautes.length ? <span title={r.bilan.sautes.join('\n')}> · <span className="n">{r.bilan.sautes.length}</span> reporté(s) au prochain passage</span> : null}
                  {r.bilan.message ? <span className="ko-texte"> · {r.bilan.message}</span> : null}
                </div>
              )}

              {tableauOuvert === f.id && (
                <>
                  <div className="onglets">
                    {(['tout', 'corbeille', 'versions'] as const).map((v) => (
                      <button key={v} className={`btn ${vue === v ? 'actif' : ''}`} onClick={() => setVue(v)}>
                        {v === 'tout' ? 'Tous les fichiers'
                          : v === 'corbeille' ? `Corbeille (${(etat.fiches?.[f.id] || []).filter((x) => x.supprime).length})`
                          : `Versions (${(etat.fiches?.[f.id] || []).filter((x) => x.versions > 1).length})`}
                      </button>
                    ))}
                  </div>
                  {vue === 'corbeille' && (
                    <div className="resume">Ces fichiers ont disparu du Mac et vivent toujours sur le drive. Rien n'a été effacé en ligne.</div>
                  )}
                  <input className="champ" style={{ marginTop: 10 }} placeholder="filtrer par nom…"
                    value={recherche} onChange={(e) => setRecherche(e.target.value)} />
                  <Tableau
                    fiches={(etat.fiches?.[f.id] || []).filter((x) =>
                      vue === 'corbeille' ? x.supprime : vue === 'versions' ? x.versions > 1 : true)}
                    filtre={recherche} dossierId={f.id} />
                </>
              )}

              {ouvert === f.id && <div className="journal">{(r?.log || []).join('\n') || 'aucune ligne pour le moment'}</div>}
            </div>
          )
        })}
      </div>
    </>
  )
}
