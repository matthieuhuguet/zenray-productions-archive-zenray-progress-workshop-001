/** LE TABLEAU DES FICHIERS. Quatre états possibles, dits par deux icônes plutôt que par un mot : sur les deux,
 *  seulement sur le drive (déchargé du Mac), seulement en local (pas encore monté), sur aucun des deux. La date
 *  et l'historique se replient : on ne les regarde qu'en cas de doute, ils ne doivent pas encombrer la lecture. */
function Tableau({ fiches, filtre, dossierId }: { fiches: Fiche[]; filtre: string; dossierId: string }) {
  const [details, setDetails] = useState(false)
  /** Un seul message à la fois : la restauration est un geste rare, qu'on regarde quand on le fait. */
  const [message, setMessage] = useState<string | null>(null)
  const [enCours, setEnCours] = useState<string | null>(null)
  const restaurer = async (rel: string) => {
    setEnCours(rel); setMessage(null)
    const r = await window.zrc.restaurer(dossierId, rel)
    setEnCours(null)
    setMessage(r.ok ? `✓ ${rel} restauré et vérifié dans ${r.message}` : `✗ ${rel} — ${r.message}`)
  }
  const [limite, setLimite] = useState(200)
  const f = filtre.trim().toLowerCase()
  const lignes = (f ? fiches.filter((x) => x.rel.toLowerCase().includes(f)) : fiches)
  if (!fiches.length) return <div className="resume">aucun fichier indexé pour l'instant — le tableau se remplit à la fin du premier envoi</div>
  return (
    <div className="tableau">
      <div className="tableau-tete">
        <span>{lignes.length} fichier(s)</span>
        <button className="btn discret" onClick={() => setDetails((v) => !v)}>
          {details ? 'masquer les dates' : 'dates et historique'}
        </button>
      </div>
      {message && <div className={message.startsWith('✓') ? 'resume' : 'sautes'}>{message}</div>}
      <table>
        <tbody>
          {lignes.slice(0, limite).map((x) => (
            <tr key={x.rel}>
              <td className="col-etat">
                <IconeNuage actif={!x.supprime} />
                <IconeLocal actif={x.local} />
              </td>
              <td className="col-nom" title={x.rel}>
                {x.rel.split('/').pop()}
                {x.depuis ? <span className="depuis" title={`déplacé depuis ${x.depuis}`}>déplacé</span> : null}
                {x.versions > 1 ? <span className="versions">{x.versions} versions</span> : null}
              </td>
              <td className="col-taille">{go(x.taille)}</td>
              {details && <td className="col-date">{x.dernier ? new Date(x.dernier).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—'}</td>}
              {details && <td className="col-chemin chemin" title={x.depuis || x.rel}>{x.depuis || x.rel}</td>}
              {/* C2 — RESTAURER. Le fichier revient dans un dossier À PART, jamais par-dessus l'original :
                  écraser un fichier local avec sa copie en ligne serait le geste destructeur qu'une
                  sauvegarde doit rendre impossible. L'empreinte est vérifiée avant écriture. */}
              <td className="col-action">
                <button className="lien" disabled={enCours === x.rel} onClick={() => restaurer(x.rel)}>
                  {enCours === x.rel ? 'restauration…' : 'restaurer'}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {lignes.length > limite && (
        <button className="btn discret" onClick={() => setLimite((n) => n + 500)}>
          voir 500 de plus ({lignes.length - limite} restants)
        </button>
      )}
    </div>
  )
}


/** LA FRISE DES ÉTAPES — montrer le cycle, pas seulement l'instant.
 *
 *  Le panneau nommait déjà correctement ce que fait l'algorithme, mais un mot seul ne dit pas OÙ l'on se
 *  trouve dans un cycle qui en compte six. On voyait « découpe » sans savoir si c'était le début ou la fin,
 *  ni ce qui viendrait après. Six pastilles suffisent à répondre : les étapes franchies sont pleines et
 *  grises, l'étape courante est pleine et bleue, celles à venir sont en simple contour. Rien n'est retiré,
 *  on ajoute la carte du chemin à côté du nom de l'endroit. */
const ETAPES: { cle: string; court: string }[] = [
  { cle: 'inventaire', court: 'liste' },
  { cle: 'empreintes', court: 'empreintes' },
  { cle: 'découpe', court: 'découpe' },
  { cle: 'envoi', court: 'envoi' },
  { cle: 'publication', court: 'manifestes' },
  { cle: 'vérification', court: 'contrôle' },
]

function Frise({ phase, p, connus }: { phase: string; p: any; connus: number }) {
  // Chaque étape porte SON chiffre sous son nom : « liste » sans nombre ne dit pas ce qui a été listé.
  // CHAQUE ÉTAPE LIT SA PROPRE GRANDEUR, et c'est tout le sujet. Les six cases affichaient auparavant le
  // même compteur `seen`, dont le sens change en cours de route : pendant la vérification il compte des
  // MORCEAUX, si bien que « liste » et « empreintes » annonçaient vingt fichiers pour un dossier qui en
  // contient treize mille. Une étape franchie doit montrer ce qu'ELLE a fait, gelé, pas ce qui se passe
  // maintenant. Les unités diffèrent d'une case à l'autre parce que le travail lui-même change de nature :
  // on liste des fichiers, on pousse des octets, on publie des manifestes, on contrôle des morceaux.
  const fichiers = p.fichiersDossier || p.total || 0
  const chiffres: Record<string, string> = {
    inventaire: `${fichiers.toLocaleString('fr-FR')} fichiers`,
    empreintes: `${fichiers.toLocaleString('fr-FR')} fichiers`,
    'découpe': p.morceaux ? `morceau ${p.morceau}/${p.morceaux}` : `${(p.seen || 0).toLocaleString('fr-FR')} vus`,
    envoi: p.envoyes ? `${(p.envoyes / 1e6).toFixed(0)} Mo confirmés` : '—',
    publication: p.publiesTotal ? `${(p.publies || 0).toLocaleString('fr-FR')}/${p.publiesTotal.toLocaleString('fr-FR')} publiés`
      : `${connus.toLocaleString('fr-FR')} en ligne`,
    'vérification': p.verifies ? `${p.verifies.toLocaleString('fr-FR')} morceaux` : 'contrôle en ligne',
  }
  // `ménage` n'est pas une étape du cycle mais un temps mort à l'intérieur de l'envoi : le montrer comme
  // une septième case laisserait croire à un recul, alors que rien n'est défait.
  const courante = phase === 'ménage' ? 'envoi' : phase
  const rang = ETAPES.findIndex((e) => e.cle === courante)
  return (
    <div className="frise" aria-label={`étape ${rang + 1} sur ${ETAPES.length}`}>
      {ETAPES.map((e, i) => (
        <div key={e.cle} className={`frise-pas ${i < rang ? 'fait' : i === rang ? 'ici' : 'avenir'}`}>
          <span className="frise-point" />
          <span className="frise-nom">{e.court}</span>
          <span className="frise-chiffre">{i <= rang ? (chiffres[e.cle] || '') : ''}</span>
        </div>
      ))}
    </div>
  )
}

/** LE RUBAN DES FICHIERS — voir défiler ce qui passe, plutôt qu'un seul nom qui change trop vite.
 *
 *  Un unique chemin remplacé toutes les deux secondes ne se lit pas : l'œil n'a pas le temps de le saisir
 *  qu'il a déjà changé, et rien ne dit ce qui vient d'être fait. Le ruban garde les derniers noms passés
 *  et met le courant en tête, ce qui rend le mouvement visible sans rien ajouter au moteur : tout vient de
 *  la progression déjà émise. */
/** LE TEMPS QUI PASSE, ET POURQUOI C'EST LA BONNE RÉPONSE À « ON DIRAIT QUE C'EST BLOQUÉ ».
 *
 *  Quand un fichier de sept gigaoctets occupe le moteur, tous les compteurs se figent : même nom, même
 *  numéro de morceau, même dépôt. L'écran devient une photographie, et une photographie ressemble à une
 *  panne. La tentation est d'ajouter une animation décorative ; elle rassurerait à tort, puisqu'elle
 *  tournerait aussi bien si le moteur était réellement mort.
 *
 *  Un chronomètre, lui, dit quelque chose de VRAI : il compte le temps réellement écoulé depuis le début
 *  du passage. Il bouge donc en permanence sans jamais mentir, et s'il se fige c'est que l'application
 *  elle-même est bloquée, ce qui est exactement l'information qu'on veut. */
function Chrono({ debut }: { debut: number }) {
  const [, battre] = useState(0)
  useEffect(() => {
    const t = setInterval(() => battre((n) => n + 1), 1000)
    return () => clearInterval(t)
  }, [])
  if (!debut) return null
  const s = Math.floor((Date.now() - debut) / 1000)
  const mm = String(Math.floor(s / 60)).padStart(2, '0')
  const ss = String(s % 60).padStart(2, '0')
  return <span className="chrono"><span className="n">{Math.floor(s / 3600) ? `${Math.floor(s / 3600)}:` : ''}{mm}:{ss}</span></span>
}

function Ruban({ rel }: { rel: string }) {
  const [passes, setPasses] = useState<string[]>([])
  const dernier = useRef('')
  useEffect(() => {
    if (!rel || rel === dernier.current) return
    if (dernier.current) setPasses((xs) => [dernier.current, ...xs].slice(0, 6))
    dernier.current = rel
  }, [rel])
  if (!rel) return null
  return (
    <div className="ruban">
      <span className="ruban-item encours" title={rel}>{rel.split('/').pop()}</span>
      {passes.map((x, i) => (
        <span key={`${x}-${i}`} className="ruban-item fini" title={x}>{x.split('/').pop()}</span>
      ))}
    </div>
  )
}

