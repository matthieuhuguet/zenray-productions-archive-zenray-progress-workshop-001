}

/** Une durée en secondes, dite comme on la dit à voix haute. « 158 400 s » n'apprend rien à personne. */
const duree = (s: number) => {
  if (!isFinite(s) || s <= 0) return '—'
  const h = Math.floor(s / 3600), m = Math.round((s % 3600) / 60)
  return h >= 1 ? `${h} h ${String(m).padStart(2, '0')}` : `${Math.max(1, m)} min`
}

/** LE TEMPS RESTANT, calculé sur le VOLUME et non sur le nombre de fichiers. Mille photos et un film de six
 *  gigaoctets ne se ressemblent pas : compter les fichiers donnerait « 99 % » pendant une heure. On ne l'affiche
 *  qu'une fois le débit établi, parce qu'une estimation fondée sur trois secondes de mesure est un mensonge. */
const resteEstime = (p: { seen: number; total: number; debut: number }) => {
  // ON ESTIME SUR LES FICHIERS ET LE TEMPS ÉCOULÉ, PLUS SUR LES OCTETS, et voici pourquoi le premier
  // calcul donnait « reste 10007 h » le 2026-08-16. Le dénominateur était le volume TOTAL du dossier,
  // trois cent soixante-huit gigaoctets, alors que la quasi-totalité de ces fichiers est déjà en ligne et
  // se saute en quelques millisecondes. On divisait donc un volume qui ne sera jamais envoyé par un débit
  // réseau proche de zéro, et le résultat n'avait aucun sens.
  //
  // Le temps écoulé rapporté aux fichiers déjà vus intègre TOUT sans rien supposer : les fichiers sautés
  // comme les fichiers montés, la lecture comme l'envoi. Il ne dit pas le débit, il dit le rythme, et
  // c'est le rythme qu'on veut connaître. Il faut un échantillon décent avant d'annoncer quoi que ce soit.
  if (!p.debut || !p.total || p.seen < 20) return null
  const ecoule = (Date.now() - p.debut) / 1000
  if (ecoule < 30) return null
  const reste = ecoule * (p.total - p.seen) / p.seen
  return reste <= 0 ? 0 : reste > 259_200 ? null : reste
}

