/** Ce que fait l'algorithme, en clair. Chaque phase a son verbe : on ne surveille pas ce qu'on ne sait pas nommer. */
const PHRASE: Record<string, string> = {
  inventaire: 'parcourt le dossier',
  empreintes: 'calcule les empreintes',
  'préparation': 'compare et route les fichiers',
  // LE MOT MENTAIT, ET C'EST LUI QUI FAISAIT CROIRE À QUATRE HEURES DE DÉCOUPE (2026-08-16). Le moteur
  // n'a jamais découpé puis envoyé en deux temps : il pousse tous les vingt à cent cinquante mégaoctets,
  // donc découpe et envoi ALTERNENT en permanence. Mais l'événement « morceau écrit » arrive bien plus
  // souvent que l'événement « lot poussé », si bien que l'écran affichait presque toujours « découpe ».
  // Un libellé qui ne nomme qu'une moitié du travail donne l'impression que l'autre moitié n'a pas lieu.
  'découpe': 'découpe et envoie en continu',
  envoi: 'pousse vers le dépôt',
  'ménage': 'efface les morceaux confirmés',
