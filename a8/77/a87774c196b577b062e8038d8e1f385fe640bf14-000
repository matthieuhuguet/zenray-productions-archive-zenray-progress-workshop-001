.zhd-scene{font-family:var(--zr-police-sans, -apple-system, BlinkMacSystemFont, sans-serif);padding:24px clamp(16px,2.5vw,40px) 70px;max-width:1240px;margin:0 auto;color:var(--g9-fg, #1d1d1f)}.zhd-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap}.zhd-titre-bloc{display:flex;flex-direction:column;gap:4px}.zhd-titre{margin:0;font-size:26px;font-weight:350;font-family:var(--zr-police-serif, Georgia, serif);letter-spacing:-.02em;color:var(--g9-fg, #111)}.zhd-titre em{font-style:italic;font-family:var(--zr-police-serif, Georgia, serif);color:#ff9f0a}.zhd-sub{margin:0;font-size:13px;color:var(--g9-muted, #6e6e73);font-weight:400}.zhd-badge-engine{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:12px;font-weight:500;background:color-mix(in srgb,#ff9f0a 12%,transparent);color:#d97706;border:1px solid color-mix(in srgb,#ff9f0a 28%,transparent)}.zhd-nav-bar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:20px;flex-wrap:wrap}.zhd-tabs{display:flex;align-items:center;gap:6px;background:color-mix(in srgb,var(--g9-fg, #000) 5%,transparent);padding:4px;border-radius:10px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}.zhd-tab-btn{border:0;background:transparent;color:var(--g9-muted, #666);padding:6px 14px;font-size:13px;font-weight:500;border-radius:7px;cursor:pointer;transition:all .15s ease;display:inline-flex;align-items:center;gap:6px}.zhd-tab-btn:hover{color:var(--g9-fg, #111)}.zhd-tab-btn.active{background:var(--g9-card-bg, rgba(255, 255, 255, .85));color:var(--g9-fg, #111);box-shadow:0 1px 3px #00000014}.zhd-search-box{position:relative;display:flex;align-items:center;min-width:240px;max-width:340px;flex:1}.zhd-search-input{width:100%;padding:7px 12px 7px 32px;border-radius:8px;border:1px solid color-mix(in srgb,var(--g9-fg, #000) 12%,transparent);background:color-mix(in srgb,var(--g9-card-bg, #fff) 80%,transparent);font-size:13px;color:var(--g9-fg, #111);outline:none;transition:border-color .15s ease}.zhd-search-input:focus{border-color:#ff9f0a}.zhd-search-icon{position:absolute;left:10px;pointer-events:none;opacity:.5}.zhd-domain-pills{display:flex;align-items:center;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:22px;scrollbar-width:none}.zhd-domain-pills::-webkit-scrollbar{display:none}.zhd-domain-pill{white-space:nowrap;border:1px solid color-mix(in srgb,var(--g9-fg, #000) 10%,transparent);background:color-mix(in srgb,var(--g9-card-bg, #fff) 60%,transparent);padding:5px 12px;border-radius:999px;font-size:12px;font-weight:500;color:var(--g9-muted, #555);cursor:pointer;transition:all .15s ease}.zhd-domain-pill:hover{border-color:color-mix(in srgb,var(--g9-fg, #000) 25%,transparent);color:var(--g9-fg, #111)}.zhd-domain-pill.active{background:#ff9f0a;border-color:#ff9f0a;color:#fff}.zhd-cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:16px}.zhd-card{background:color-mix(in srgb,var(--g9-card-bg, rgba(255, 255, 255, .75)) 85%,transparent);border:1px solid color-mix(in srgb,var(--g9-fg, #000) 9%,transparent);border-radius:14px;padding:18px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 4px 16px #00000008;display:flex;flex-direction:column;gap:12px;transition:transform .15s ease,box-shadow .15s ease}.zhd-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px #0000000f}.zhd-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.zhd-card-title{margin:0;font-size:16px;font-weight:600;color:var(--g9-fg, #111)}.zhd-card-domain-badge{font-size:11px;padding:2px 8px;border-radius:999px;font-weight:500;background:color-mix(in srgb,#ff9f0a 10%,transparent);color:#d97706}.zhd-card-summary{margin:0;font-size:13px;line-height:1.45;color:var(--g9-fg, #333)}.zhd-card-meta{display:flex;flex-wrap:wrap;gap:6px}.zhd-node-badge{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;padding:2px 6px;border-radius:4px;background:color-mix(in srgb,#007aff 10%,transparent);color:#06c;border:1px solid color-mix(in srgb,#007aff 20%,transparent)}.zhd-attr-badge{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;padding:2px 6px;border-radius:4px;background:color-mix(in srgb,#30d158 10%,transparent);color:#248a3d;border:1px solid color-mix(in srgb,#30d158 20%,transparent)}.zhd-card-unreal{font-size:12px;color:var(--g9-muted, #666);display:flex;align-items:center;gap:6px}.zhd-card-unreal strong{color:var(--g9-fg, #222)}.zhd-card-explanation{font-size:12.5px;line-height:1.5;color:var(--g9-muted, #444);background:color-mix(in srgb,var(--g9-fg, #000) 3%,transparent);padding:10px 12px;border-radius:8px}.zhd-card-code{position:relative;background:#1c1c1e;border-radius:8px;padding:12px;overflow-x:auto}.zhd-card-code pre{margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;line-height:1.45;color:#e5e5ea}.zhd-card-copy-btn{position:absolute;top:8px;right:8px;border:0;background:#ffffff26;color:#fff;border-radius:4px;padding:4px 8px;font-size:10px;cursor:pointer;transition:background .15s ease}.zhd-card-copy-btn:hover{background:#ffffff47}.zhd-pipeline-container{display:flex;flex-direction:column;gap:16px}.zhd-pipeline-card{display:flex;align-items:flex-start;gap:16px;padding:18px 20px;border-radius:12px;background:color-mix(in srgb,var(--g9-card-bg, #fff) 85%,transparent);border:1px solid color-mix(in srgb,var(--g9-fg, #000) 8%,transparent);box-shadow:0 2px 10px #00000005}.zhd-pipeline-step-num{width:34px;height:34px;flex-shrink:0;border-radius:50%;background:#ff9f0a;color:#fff;display:grid;place-items:center;font-weight:700;font-size:15px}.zhd-pipeline-info{display:flex;flex-direction:column;gap:4px}.zhd-pipeline-info h4{margin:0;font-size:16px;font-weight:600}.zhd-pipeline-tool{font-size:12px;color:#007aff;font-weight:500}.zhd-pipeline-info p{margin:4px 0 0;font-size:13.5px;line-height:1.45;color:var(--g9-muted, #555)}@media (max-width: 768px){.zhd-cards-grid{grid-template-columns:1fr}.zhd-search-box{max-width:100%}.zhd-nav-bar{flex-direction:column;align-items:stretch}}.zhd-voc{display:flex;flex-direction:column;gap:14px;padding:4px 0 40px}.zhd-voc-state{padding:34px 20px;text-align:center;color:var(--g9-muted);font-size:13px;line-height:1.7}.zhd-voc-measures{display:flex;flex-wrap:wrap;gap:18px;font-size:12px;color:var(--g9-muted);padding:2px 2px 0}.zhd-voc-measures strong{color:var(--g9-text);font-weight:500}.zhd-voc-bar{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.zhd-voc-count{font-size:12px;color:var(--g9-muted);padding-left:2px}.zhd-voc-counter{font-style:normal;opacity:.55;margin-left:6px;font-size:11px}.zhd-voc-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}.zhd-voc-row{display:grid;grid-template-columns:minmax(180px,22%) 1fr minmax(0,20%);gap:14px;align-items:baseline;padding:7px 10px;border-radius:8px;font-size:12.5px}.zhd-voc-row:nth-child(odd){background:color-mix(in srgb,var(--g9-text) 3.5%,transparent)}.zhd-voc-name{font-family:var(--zr-police-mono, ui-monospace, monospace);font-size:12px;color:var(--g9-text);word-break:break-word}.zhd-voc-summary{color:var(--g9-muted);line-height:1.55}.zhd-voc-families{font-size:11px;color:var(--g9-muted);opacity:.65;text-align:right}@media (max-width: 860px){.zhd-voc-row{grid-template-columns:1fr;gap:3px}.zhd-voc-families{text-align:left}}
