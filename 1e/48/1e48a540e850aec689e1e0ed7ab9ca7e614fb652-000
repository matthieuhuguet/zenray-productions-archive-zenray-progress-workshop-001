.zr-segmente{display:inline-flex;align-items:center;padding:4px;border-radius:999px;background:color-mix(in srgb,var(--g9-fg) 6%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--g9-fg) 10%,transparent);max-width:100%;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}.zr-segmente::-webkit-scrollbar{display:none}.zr-seg-trait{width:1px;height:18px;flex:0 0 1px;background:color-mix(in srgb,var(--g9-fg) 15%,transparent);transition:opacity .18s ease}.zr-seg:hover+.zr-seg-trait,.zr-seg.zr-seg-actif+.zr-seg-trait,.zr-seg-trait:has(+.zr-seg:hover),.zr-seg-trait:has(+.zr-seg.zr-seg-actif){opacity:0}.zr-seg{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 20px;border:0;background:transparent;border-radius:999px;cursor:pointer;color:var(--g9-muted);font-family:var(--zr-police-sans);font-size:14px;font-weight:300;white-space:nowrap;flex:0 0 auto;transition:background .18s ease,color .18s ease,transform .18s cubic-bezier(.34,1.56,.64,1)}.zr-seg:hover{background:color-mix(in srgb,var(--g9-fg) 13%,transparent);color:var(--g9-fg)}.zr-seg:active{transform:scale(.94)}.zr-seg.zr-seg-actif{color:var(--g9-fg);font-weight:400;background:color-mix(in srgb,var(--g9-fg) 20%,transparent);box-shadow:0 1px 3px color-mix(in srgb,#000 22%,transparent)}.zr-seg:focus-visible{outline:2px solid var(--zrp-blue, #3b82f7);outline-offset:1px}.zr-seg-statique{cursor:default}.zr-seg-statique:active{transform:none}.zr-seg-compte{font-family:var(--zr-police-serif);font-style:normal;font-weight:400;font-size:12px;color:var(--g9-muted);opacity:.8}.zr-seg.zr-seg-actif .zr-seg-compte{color:var(--g9-fg);opacity:.7}@media (prefers-reduced-motion: reduce){.zr-seg,.zr-seg-trait{transition-duration:.01ms!important}}
