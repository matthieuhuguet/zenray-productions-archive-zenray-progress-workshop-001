  for (let occurrence = 1; ; occurrence++) {
    const candidate = restorationCandidate(requestedPath, occurrence)
    try {
      // 3 October 2026, 09:39 CEST: the hard link publishes one inode atomically and refuses a concurrent destination.
      // 3 October 2026, 09:39 CEST: default downloads keep alternate names; exact managed identities reject the collision.
      await link(temporaryPath, candidate)
      let temporaryRemoved = true
      try { await rm(temporaryPath) } catch { temporaryRemoved = false }
      return { path: candidate, temporaryRemoved }
    } catch (error) {
      if (error?.code !== 'EEXIST' || onConflict === 'reject') throw error
    }
  }
}

export function writeBuffer(stream, buffer) {
  return new Promise((resolve, reject) => stream.write(buffer, (error) => error ? reject(error) : resolve()))
}

export function closeWritable(stream) {
  return new Promise((resolve, reject) => {
    stream.once('error', reject)
    stream.end(resolve)
  })
}
